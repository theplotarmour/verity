# Verity environment configuration.
#
# Copy to .env and fill in. Values here are placeholders, never real secrets.
#
# PRECEDENCE WARNING
# Next.js loads .env.local at higher precedence than .env, but the Prisma CLI
# reads .env ONLY. Setting DATABASE_URL in .env.local therefore points the
# running app at one database while `prisma migrate` targets another. Keep all
# connection details in .env.

# ============================================================
# REQUIRED
# ============================================================

# Postgres via Supabase's transaction pooler (port 6543). Runtime queries.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler / direct connection (port 5432). Migrations only — DDL cannot
# run through the transaction pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Signs the session cookie.
#
# FAILS OPEN: src/lib/server/auth.ts, src/server/actions/auth.ts and
# src/lib/server/hash.ts all fall back to a hardcoded dev string when this is
# unset. That string is in the repository, so an unset secret means anyone
# reading the source can forge a session. Always set it.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Supabase — client-side. These ship to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase — server-side only. The service-role key bypasses row-level
# security; never give it a NEXT_PUBLIC_ prefix.
# SUPABASE_URL is optional: the admin client falls back to
# NEXT_PUBLIC_SUPABASE_URL when it is unset.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ============================================================
# EFFECTIVELY REQUIRED IN PRODUCTION
# ============================================================

# Public app URL, used in invites, PIN resets and passport share links.
# Falls back to https://app.theverityai.xyz (src/lib/brand.ts).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Storage bucket for QC photos and video.
# NOTE: no NEXT_PUBLIC_ prefix — src/lib/storage/config.ts reads this exact
# name. Defaults to "factory-media" when unset.
SUPABASE_MEDIA_BUCKET="factory-media"

# Shared secret guarding the maintenance routes (/api/backfill,
# /api/seed-owner, /api/delete-productions). Unset means those routes reject
# every request, which is the safe default.
MAINTENANCE_TOKEN=""

# ============================================================
# OPTIONAL — the feature is skipped and logged when unset
# ============================================================

# Email notifications. Both are required together.
RESEND_API_KEY=""
NOTIFY_EMAIL_FROM=""

# WhatsApp notifications. Both are required together.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Prisma connection pool size. Defaults to 5.
DATABASE_POOL_LIMIT="5"

# Service-worker cache key. Vercel provides VERCEL_GIT_COMMIT_SHA
# automatically; set this only for non-Vercel deployments.
NEXT_PUBLIC_BUILD_ID=""

# ============================================================
# NOT WIRED UP — no code reads these
# ============================================================
#
# An S3-compatible storage provider was started and never finished. All media
# goes through the Supabase JS client (src/lib/storage/upload.ts), not the S3
# protocol. @aws-sdk/client-s3 and @aws-sdk/s3-request-presigner are installed
# but imported nowhere. Same for `inngest`.
#
# Delete these once the intent is settled, or implement a StorageProvider
# behind src/lib/storage/upload.ts.
#
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
