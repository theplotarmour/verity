// Verity Platform Foundation — Phase 0 baseline.
//
// Scope: the tenancy substrate only (Tenant, Organization) plus the base entity
// pattern every future capability inherits. No business capability is modelled here.
//
// Authority:
//   Bible V1        — Prisma/PostgreSQL is the system of record
//   Bible V5 §1     — tenant isolation is absolute; RLS at the engine level
//   ADR-005         — Tenant is the root data-isolation boundary;
//                     Organization is a nested business unit inside a Tenant
//   Spec PLA-TEN-001 — every operational table partitioned by tenant
//   Spec PLA-TEN-003 — no cross-tenant foreign keys
//   Spec PLA-ORG-001 — Organizations nest self-referentially
//
// Base entity pattern (implementation/02-foundation-build-order/bootstrap-sequence.md, step 7):
//   id, tenantId, createdAt, updatedAt, version, customFields
// `version` carries optimistic concurrency; `customFields` is the extension
// surface required by PLA-EXT-001 so capabilities extend entities without
// altering the platform ontology.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The root data-isolation boundary — the client contract boundary (ADR-005).
/// A Tenant is not itself tenant-scoped, so it carries no `tenantId`.
model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  /// IANA zone for reckoning local time. Null means UTC, stated explicitly
  /// rather than guessed — a wrong guess misplaces every deadline by the offset.
  timeZone     String?  @map("time_zone")
  /// True for the single Verity platform tenant whose members are HQ operators;
  /// never true for a client. D18 requires that "operator" and "tenant user" be
  /// distinguishable in code, in the UI and in audit, and a naming convention
  /// cannot answer an authority question (ADR-013).
  isPlatform   Boolean  @default(false) @map("is_platform")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  organizations           Organization[]
  memberships             TenantMembership[]
  roles                   Role[]
  permissions             Permission[]
  roleCompositions        RoleComposition[]
  customFieldSchemas      CustomFieldSchema[]
  domainEvents            DomainEvent[]
  statusLabels            TenantStatusLabel[]
  activities              Activity[]
  securityEvents          SecurityAuditEvent[]
  workflows               WorkflowDefinition[]
  workflowRuns            WorkflowRun[]
  credentials             Credential[]
  activations             TenantActivation[]
  configParameters        ConfigParameter[]
  offlineCommands         OfflineCommand[]
  syncExceptions          SyncException[]
  places                  Place[]
  addresses               Address[]
  locations               Location[]
  geofences               Geofence[]
  locationAssignments     LocationAssignment[]
  assets                  Asset[]
  evidence                Evidence[]
  resources               Resource[]
  resourceGroups          ResourceGroup[]
  resourceGroupMembers    ResourceGroupMember[]
  availabilityWindows     AvailabilityWindow[]
  bookings                Booking[]
  approvalRequests        ApprovalRequest[]
  approvalSteps           ApprovalStep[]
  businessCalendars       BusinessCalendar[]
  businessHours           BusinessHours[]
  businessHolidays        BusinessHoliday[]
  slaPolicies             SlaPolicy[]
  slaClocks               SlaClock[]
  storedFiles             StoredFile[]
  notificationTemplates   NotificationTemplate[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  // Capability: dine-in. Back-relations only — Prisma requires the opposite
  // side of every relation, so a capability's tables show up here whether or not
  // the platform cares about them. Nothing on this side is platform behaviour.
  menuCategories          MenuCategory[]
  menuItems               MenuItem[]
  menuVariants            MenuItemVariant[]
  diningZones             DiningZone[]
  diningTables            DiningTable[]
  diningOrders            DiningOrder[]
  orderLines              OrderLine[]
  bills                   Bill[]
  payments                Payment[]

  @@map("tenant")
}

/// A functional, legal, or regional node inside a Tenant (ADR-005, PLA-ORG-001).
/// Nests self-referentially: Holdings -> Region -> Branch -> Site Office.
model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  name         String
  /// Overrides the tenant zone for this branch. A portfolio genuinely spans
  /// zones, and a regional manager reads times in the site's local clock.
  timeZone     String?  @map("time_zone")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // PLA-TEN-003: the parent link is keyed on (tenantId, parentId) rather than
  // parentId alone, so the database itself refuses a cross-tenant parent.
  parent      Organization?      @relation("OrganizationHierarchy", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  children    Organization[]     @relation("OrganizationHierarchy")
  memberships TenantMembership[]
  locations   Location[]

  @@unique([tenantId, id], name: "organization_tenant_scoped_id")
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("organization")
}

/// Party lifecycle (Authority: Bible V2 Primitive 2 §3-§5, ADR-001).
/// ADR-001 keeps these platform-level only: capability-specific lifecycles
/// (CRM `Prospect`, Workforce `Employee`) belong inside those capabilities and
/// map back to this primitive, they do not extend it.
enum PartyState {
  Invited
  Active
  Suspended
  Archived
}

/// The single canonical record for any human or corporate participant.
///
/// GLOBAL, not tenant-scoped. Authority: Bible V2 Primitive 2 §2 — "Scoped
/// globally to the Platform database, mapped to Organizations via
/// TenantMembership records" — and INV-003, which requires exactly one Party
/// per person across the whole platform even when they work for many tenants
/// (PLA-IDE-004, the subcontractor case). A `tenantId` column here would force
/// one row per tenant and break INV-003.
///
/// Visibility is therefore not a tenant column but reachability: a tenant sees
/// a Party only if that Party's User holds a TenantMembership in it. See the
/// RLS policies in the migration.
///
/// No address field: ADR-004 makes Address a distinct concept from Party and
/// forbids folding mailing details into another primitive.
model Party {
  id           String     @id @default(uuid()) @db.Uuid
  /// Human or corporate participant, so the label is a single display name;
  /// given/family names are optional and only meaningful for humans.
  displayName  String     @map("display_name")
  givenName    String?    @map("given_name")
  familyName   String?    @map("family_name")
  /// Bible V2 Primitive 2 §8: identity evidence is a verified email or phone.
  email        String?
  phone        String?
  state        PartyState @default(Invited)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  version      Int        @default(1)
  customFields Json       @default("{}") @map("custom_fields")

  user      User?
  resources Resource[]

  @@index([email])
  @@index([phone])
  @@map("party")
}

/// The authenticating actor. GLOBAL, for the same reason as Party.
///
/// 1:1 with Party (GOV-TER-006, INV-003). Bible V2 Primitive 2 §1 describes
/// User as storing "credentials and passwords"; authentication is offloaded to
/// Supabase Auth (Authority: EXISTING INFRASTRUCTURE, and
/// implementation/03-platform-foundation/identity.md), so no credential
/// material is stored here — `authUserId` references the Supabase `auth.users`
/// row. Keeping a second credential store would duplicate the source of truth.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Supabase Auth user id. Single global realm (Bible V5 §1.A.4).
  authUserId   String   @unique @map("auth_user_id") @db.Uuid
  partyId      String   @unique @map("party_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  party                   Party                    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  memberships             TenantMembership[]
  locationAssignments     LocationAssignment[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  @@map("user")
}

/// Binds a global User into one Organization inside one Tenant.
///
/// Authority: Bible V2 Primitive 2 §2 and §13 (authorization is defined at the
/// membership level), Bible V5 §1.A.4 (one identity, distinct memberships per
/// tenant), Spec PLA-IDE-002, implementation/03-platform-foundation/membership.md.
///
/// This IS tenant-scoped and carries the RLS boundary. `roleId` is specified by
/// the handoff but deferred: Role belongs to the authorization step and does not
/// exist yet, and inventing it here would pre-empt that design.
model TenantMembership {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String?  @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)
  customFields   Json     @default("{}") @map("custom_fields")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // PLA-TEN-003 again: keyed on (tenantId, organizationId) so the database
  // refuses a membership pointing at another tenant's Organization.
  organization Organization @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  // Nullable on purpose: a membership with no Role grants nothing, so an
  // unassigned membership fails closed instead of defaulting to access.
  // Restrict, not SetNull: a composite key cannot null `tenantId`, and a Role
  // must not vanish from under a live membership — reassign first.
  role         Role?        @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([userId, organizationId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_membership")
}

/// Permission verbs (Authority: Spec PLA-AUT-003).
/// A closed set: a bespoke capability action is expressed as `ActionExecute`
/// against a named entity, so a new capability never needs a new verb.
enum PermissionVerb {
  Read
  Create
  Edit
  Delete
  ActionExecute
}

/// Permission scope levels (Authority: Spec PLA-AUT-002, refining Bible V2
/// Primitive 2 §13, which lists Global/Tenant/Site; the spec adds Organization,
/// which ADR-005 requires as a real nesting level inside a Tenant).
///
/// `Global` means cross-tenant platform administration. It is defined because the
/// specification defines it, but nothing here grants it: honouring it would mean
/// bypassing the RLS that enforces INV-001, and that security decision has not
/// been made. `resolvePermissions` refuses to return Global grants.
enum PermissionScope {
  Global
  Tenant
  Organization
  Location
}

/// A named bundle of permissions inside one Tenant (Authority: Spec PLA-AUT-001).
model Role {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions   Permission[]
  memberships   TenantMembership[]
  /// Compositions where this Role is the parent — it inherits from the child.
  approvalSteps ApprovalStep[]
  parentOf      RoleComposition[]  @relation("RoleCompositionParent")
  /// Compositions where this Role is the child — its permissions flow upward.
  childOf       RoleComposition[]  @relation("RoleCompositionChild")

  @@unique([tenantId, name])
  @@unique([tenantId, id], name: "role_tenant_scoped_id")
  @@index([tenantId])
  @@map("role")
}

/// Composite-role edge (Authority: Spec PLA-AUT-001; Bible Synthesis ADOPTED —
/// Keycloak composite roles). A parent Role inherits every permission held by its
/// child Roles, flattened at runtime.
///
/// The spec names this `RoleComposition`; the handoff calls it `RoleInheritance`.
/// The spec outranks the handoff.
model RoleComposition {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  parentRoleId String   @map("parent_role_id") @db.Uuid
  childRoleId  String   @map("child_role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentRole Role   @relation("RoleCompositionParent", fields: [tenantId, parentRoleId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  childRole  Role   @relation("RoleCompositionChild", fields: [tenantId, childRoleId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([parentRoleId, childRoleId])
  @@index([tenantId])
  @@map("role_composition")
}

/// A single grant: Verb + Entity + Scope (Authority: implementation handoff
/// 03-platform-foundation/authorization.md; Spec PLA-AUT-003).
///
/// `entity` is a free string rather than an enum, deliberately: a new capability
/// must introduce entities without altering the platform ontology.
model Permission {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  roleId    String          @map("role_id") @db.Uuid
  verb      PermissionVerb
  entity    String
  scope     PermissionScope
  createdAt DateTime        @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([roleId, verb, entity, scope])
  @@index([tenantId])
  @@index([roleId])
  @@map("permission")
}

/// Entity structural classes (Authority: Spec MET-ENT-001→003).
enum EntityClass {
  /// Permanent business record backed by a physical table.
  Persistent
  /// Session-scoped temporary state; emits no state events (MET-ENT-002).
  Transient
  /// Interface/mixin template; no table of its own (MET-ENT-003).
  Abstract
}

/// Custom field types (Authority: Spec PLA-EXT-002, which fixes exactly this set).
enum CustomFieldType {
  String
  Number
  Boolean
  Select
  Date
}

/// The entity registry (Authority: Spec MET-ENT-001→005).
///
/// GLOBAL, not tenant-scoped. An entity definition describes a *type*, is
/// identical for every tenant, and is written by migrations when a capability is
/// installed — it is platform metadata of the kind PLA-TEN-001 exempts from
/// tenant partitioning ("global system lists"). Tenant-specific shape lives in
/// `CustomFieldSchema` instead.
///
/// A capability ships its own tables and registers them here; the platform does
/// not generate tables at runtime. That is what lets a new capability introduce
/// entities without the platform ontology changing (foundation-ready B).
model EntityDefinition {
  /// Namespace-qualified unique key, e.g. `verity.work.work_order` (MET-ENT-004).
  key          String      @id
  /// Owning capability. Every entity has exactly one owner.
  capability   String
  class        EntityClass
  /// Physical table for a Persistent entity; null for Transient/Abstract.
  tableName    String?     @map("table_name")
  /// False only for platform-wide system reference data (MET-ENT-005).
  tenantScoped Boolean     @default(true) @map("tenant_scoped")
  createdAt    DateTime    @default(now()) @map("created_at")

  customFields     CustomFieldSchema[]
  states           StateDefinition[]
  fieldPermissions FieldPermission[]

  @@index([capability])
  @@map("entity_definition")
}

/// Tenant-declared extension fields (Authority: Spec PLA-EXT-002).
///
/// Tenant-scoped, unlike EntityDefinition: these are one tenant's additions to an
/// entity, stored in that entity's `custom_fields` JSONB column (PLA-EXT-001) so
/// the relational core schema stays intact and no migration is needed to add one.
model CustomFieldSchema {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  /// FK to EntityDefinition.key — the entity being extended.
  entityKey     String          @map("entity_key")
  fieldName     String          @map("field_name")
  fieldType     CustomFieldType @map("field_type")
  required      Boolean         @default(false)
  /// Only meaningful when fieldType is Select.
  selectOptions String[]        @default([]) @map("select_options")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity EntityDefinition @relation(fields: [entityKey], references: [key], onDelete: Cascade)

  @@unique([tenantId, entityKey, fieldName])
  @@index([tenantId, entityKey])
  @@map("custom_field_schema")
}

/// Transactional event outbox (Authority: Spec MET-ACT-004, MET-EVE-001→002).
///
/// An Event is a fact: something happened. Rows are written inside the same
/// transaction as the mutation that produced them, which is what makes
/// MET-ACT-004's "events must never be emitted if the transaction rolls back"
/// structurally true rather than a convention a caller could forget.
///
/// Immutable: RLS grants INSERT and SELECT only, so a delivered event cannot be
/// rewritten or deleted by the application. Delivery marking is performed by the
/// dispatcher role.
model DomainEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// Namespace-qualified event name, e.g. `verity.party.suspended`.
  name        String
  /// The entity the fact concerns (EntityDefinition.key).
  entityKey   String    @map("entity_key")
  entityId    String?   @map("entity_id") @db.Uuid
  /// The command that produced it, for traceability back to the action.
  commandKey  String?   @map("command_key")
  /// Actor at the time of the fact; null for platform-initiated events.
  actorUserId String?   @map("actor_user_id") @db.Uuid
  payload     Json      @default("{}")
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  /// Set by the dispatcher once delivered; null means pending.
  deliveredAt DateTime? @map("delivered_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([deliveredAt])
  @@map("domain_event")
}

/// Platform state categories (Authority: Spec MET-STA-001, MET-STA-004).
///
/// MET-STA-001 calls the categories "fixed, platform-level enums" but illustrates
/// them with Work-domain values (`EN_ROUTE`, `SCHEDULING`). Those are the Work
/// capability's *states*, not platform categories — hardcoding them into the core
/// would be the same domain leakage the no-legacy policy forbids and would make
/// the platform field-service specific.
///
/// The fixed set below is therefore behavioural, not domain: it says what the
/// engine must do, which is exactly what MET-STA-004 needs when it evaluates SLA
/// clocks "strictly at the system StateCategory layer".
///
///   Draft     — not yet started; no SLA clock
///   Pending   — waiting on something external; clock paused
///   Active    — work is happening; clock running
///   Blocked   — halted by an exception; clock paused
///   Completed — terminal, succeeded; clock stopped
///   Cancelled — terminal, abandoned; clock stopped
///
/// IMPLEMENTATION DECISION: the specification mandates that categories exist and
/// fixes their engine meaning, but does not enumerate a domain-neutral set. This
/// set is inferred from MET-STA-004's clock semantics and needs ratification.
enum StateCategory {
  Draft
  Pending
  Active
  Blocked
  Completed
  Cancelled
}

/// One state in an entity's lifecycle (Authority: Spec MET-STA-001, MET-STA-003).
///
/// GLOBAL, like EntityDefinition: a lifecycle belongs to the capability that owns
/// the entity and is identical for every tenant. Tenants rename states via
/// TenantStatusLabel; they do not add or remove them.
model StateDefinition {
  id         String        @id @default(uuid()) @db.Uuid
  entityKey  String        @map("entity_key")
  /// Stable machine key, e.g. `in_progress`.
  key        String
  /// Mandatory category binding (MET-STA-003).
  category   StateCategory
  /// Exactly one initial state per entity.
  isInitial  Boolean       @default(false) @map("is_initial")
  /// Terminal states lock the entity (INV-002).
  isTerminal Boolean       @default(false) @map("is_terminal")

  entity          EntityDefinition       @relation(fields: [entityKey], references: [key], onDelete: Cascade)
  fromTransitions TransitionDefinition[] @relation("TransitionFrom")
  toTransitions   TransitionDefinition[] @relation("TransitionTo")
  labels          TenantStatusLabel[]

  @@unique([entityKey, key])
  @@index([entityKey])
  @@map("state_definition")
}

/// An allowed movement between two states (Authority: Spec MET-TRA-001).
///
/// The structural guard is this table: a transition that is not declared here
/// cannot happen, so `Completed -> Draft` is blocked by absence rather than by a
/// check somebody has to remember to write.
model TransitionDefinition {
  id          String  @id @default(uuid()) @db.Uuid
  entityKey   String  @map("entity_key")
  fromStateId String  @map("from_state_id") @db.Uuid
  toStateId   String  @map("to_state_id") @db.Uuid
  /// The Action permitted to trigger it; the authorization guard (MET-TRA-002)
  /// is the command pipeline's own check on this command.
  commandKey  String? @map("command_key")

  fromState StateDefinition @relation("TransitionFrom", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState   StateDefinition @relation("TransitionTo", fields: [toStateId], references: [id], onDelete: Cascade)

  @@unique([fromStateId, toStateId])
  @@index([entityKey])
  @@map("transition_definition")
}

/// Tenant-facing label for a platform state (Authority: Spec MET-STA-002/003).
///
/// Tenant-scoped: "Awaiting Gate Pass" is one tenant's word for a state whose
/// category the engine still reasons about unchanged (MET-STA-004).
model TenantStatusLabel {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  stateId  String @map("state_id") @db.Uuid
  label    String

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  state  StateDefinition @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([tenantId, stateId])
  @@index([tenantId])
  @@map("tenant_status_label")
}

/// Operational audit stream (Authority: Spec EXE-AUD-001, GOV-TER "Activity").
///
/// EXE-AUD-001 names the table `WorkOrderActivity` with a `work_order_id` FK.
/// That is domain leakage: the platform cannot own a table keyed to one
/// capability's entity, and GOV-TER already reserves `Activity` as the canonical
/// term for a change record. The generic form keys on (entityKey, entityId), so
/// every capability's changes land in one stream without the core knowing any of
/// them.
///
/// Retention is infinite (EXE-AUD-001: required for contract disputes and
/// historical SLAs), and rows are immutable at the database level (EXE-AUD-003).
model Activity {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  entityKey    String   @map("entity_key")
  entityId     String   @map("entity_id") @db.Uuid
  /// Null for platform-initiated changes with no human actor.
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  fieldChanged String   @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  /// The command responsible, so a change traces back to the action.
  commandKey   String?  @map("command_key")
  occurredAt   DateTime @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityKey, entityId])
  @@index([tenantId, occurredAt])
  @@map("activity")
}

/// Security audit event types (Authority: Spec EXE-AUD-002).
enum SecurityEventType {
  AuthSuccess
  AuthFailed
  /// An authenticated principal was refused a privileged surface. Distinct from
  /// AuthFailed, which is a failure to prove identity — merging the two would
  /// make "someone is probing HQ" and "someone mistyped a password" the same
  /// signal (ADR-013 answer 11, D18).
  AuthorizationDenied
  PermissionEscalated
  PermissionRevoked
  RoleAssigned
  ConfigurationChanged
  ApiKeyGenerated
}

/// Security audit stream (Authority: Spec EXE-AUD-002).
///
/// Separate from Activity because its retention is compliance-driven rather than
/// infinite, and because mixing authentication and permission changes into the
/// operational stream makes both harder to reason about.
///
/// `tenantId` is required: an event that concerns no tenant cannot be shown to
/// one without leaking across the boundary. Pre-authentication failures, which
/// have no tenant yet, belong to platform operations and are out of scope until
/// the auth layer exists.
model SecurityAuditEvent {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  eventType   SecurityEventType @map("event_type")
  actorUserId String?           @map("actor_user_id") @db.Uuid
  /// Recorded as text: it is evidence, not a queryable address type.
  ipAddress   String?           @map("ip_address")
  payload     Json              @default("{}")
  occurredAt  DateTime          @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([tenantId, eventType])
  @@map("security_audit_event")
}

/// Automation node categories (Authority: Spec MET-AUT-001).
enum WorkflowNodeType {
  /// Listens for a platform Event, schedule, or webhook and starts a run.
  Trigger
  /// Executes an integration or mutates an entity.
  Action
  /// Directs flow: conditionals, branching, joins.
  Logic
}

enum WorkflowRunStatus {
  Running
  Succeeded
  Failed
}

/// An orchestrated business process (Authority: Spec MET-WKF-001→003, MET-AUT-001).
///
/// Tenant-scoped and stored as data, not code. The engine knows how to walk a
/// DAG and how to run a *node type*; it knows nothing about any particular
/// workflow. That is what lets a new workflow be introduced without the engine
/// changing — foundation-ready condition C.
model WorkflowDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  /// Bumped when the graph changes; a run records the version it executed.
  version   Int      @default(1)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nodes  WorkflowNode[]
  edges  WorkflowEdge[]
  runs   WorkflowRun[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("workflow_definition")
}

/// One node in the graph (Authority: Spec MET-AUT-001).
///
/// `handlerKey` names a node type registered in code. The node's behaviour lives
/// there; `config` is its data. A capability adds capabilities by registering a
/// handler, never by editing the executor.
model WorkflowNode {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  workflowId String           @map("workflow_id") @db.Uuid
  key        String
  type       WorkflowNodeType
  /// Registered node-type key, e.g. `verity.core.emit_event`.
  handlerKey String           @map("handler_key")
  config     Json             @default("{}")

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  outgoing WorkflowEdge[]     @relation("EdgeFrom")
  incoming WorkflowEdge[]     @relation("EdgeTo")
  stepRuns WorkflowStepRun[]

  @@unique([workflowId, key])
  @@index([tenantId])
  @@map("workflow_node")
}

/// A directed edge, optionally conditional (Authority: Spec MET-WKF-002).
///
/// `condition` is a declarative predicate over the envelope, not code: routing
/// decisions are data so a tenant can change a threshold without a deploy.
model WorkflowEdge {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  workflowId String @map("workflow_id") @db.Uuid
  fromNodeId String @map("from_node_id") @db.Uuid
  toNodeId   String @map("to_node_id") @db.Uuid
  /// null means unconditional.
  condition  Json?

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromNode WorkflowNode       @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   WorkflowNode       @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId])
  @@index([tenantId])
  @@map("workflow_edge")
}

/// One execution of a workflow.
model WorkflowRun {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  workflowId      String            @map("workflow_id") @db.Uuid
  workflowVersion Int               @map("workflow_version")
  status          WorkflowRunStatus @default(Running)
  /// Deduplication key: the same trigger fact must not start two runs.
  idempotencyKey  String?           @map("idempotency_key")
  triggerEventId  String?           @map("trigger_event_id") @db.Uuid
  input           Json              @default("{}")
  error           String?
  startedAt       DateTime          @default(now()) @map("started_at")
  finishedAt      DateTime?         @map("finished_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps    WorkflowStepRun[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@map("workflow_run")
}

/// One node execution within a run (Authority: Spec MET-WKF-001).
///
/// Each step is its own transaction boundary, and its output envelope is
/// recorded so a failed run can be inspected without re-running it.
model WorkflowStepRun {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  runId      String            @map("run_id") @db.Uuid
  nodeId     String            @map("node_id") @db.Uuid
  sequence   Int
  status     WorkflowRunStatus @default(Running)
  output     Json              @default("{}")
  error      String?
  startedAt  DateTime          @default(now()) @map("started_at")
  finishedAt DateTime?         @map("finished_at")

  run  WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  node WorkflowNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([runId, sequence])
  @@map("workflow_step_run")
}

/// Encrypted third-party secrets (Authority: Spec MET-AUT-003).
///
/// Automations reference a credential by name; the ciphertext is decrypted only
/// at execution time inside the action node. The secret never appears in a
/// workflow's JSON configuration, so exporting or logging a workflow cannot leak
/// it.
model Credential {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// pgcrypto ciphertext. Never selected into application memory except by
  /// verity.credential_reveal() at execution time.
  secret    Bytes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("credential")
}

enum ActivationStatus {
  Active
  Suspended
}

/// Configuration precedence scopes (Authority: Spec PLA-CFG-001).
/// Narrowest wins: User > Organization > Tenant > Global.
enum ConfigScope {
  Global
  Tenant
  Organization
  User
}

/// The capability registry (Authority: Spec PLA-CAP-001, PLA-VER-002).
///
/// GLOBAL, like EntityDefinition: a capability's identity, version and
/// dependencies are platform facts, written when the capability is installed.
/// Which tenants may use it is a separate, tenant-scoped question answered by
/// TenantActivation.
model CapabilityDefinition {
  id           String   @id
  name         String
  /// SemVer of the capability's logic (PLA-VER-002).
  version      String
  /// Capability ids this one requires (PLA-CAP-003).
  dependencies String[] @default([])
  /// EntityDefinition keys this capability owns.
  entityTypes  String[] @default([]) @map("entity_types")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  activations TenantActivation[]

  @@map("capability_definition")
}

/// Per-tenant activation (Authority: Spec PLA-CAP-002, PLA-CAP-003).
///
/// An inactive capability is fully blocked for that tenant — not merely hidden
/// in the UI. Enforcement lives in the command and query pipelines, because a
/// capability that is invisible but still reachable by API is not deactivated.
model TenantActivation {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  capabilityId  String           @map("capability_id")
  status        ActivationStatus @default(Active)
  activatedAt   DateTime         @default(now()) @map("activated_at")
  /// Version pinned at activation (PLA-VER-003), so a platform upgrade cannot
  /// silently change a tenant's behaviour.
  pinnedVersion String?          @map("pinned_version")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capability CapabilityDefinition @relation(fields: [capabilityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, capabilityId])
  @@index([tenantId])
  @@map("tenant_activation")
}

/// A configuration value at one precedence scope (Authority: Spec PLA-CFG-001).
///
/// `scopeId` identifies the organization or user for the narrower scopes and is
/// null for Tenant and Global. Resolution walks narrowest to broadest and takes
/// the first hit.
model ConfigParameter {
  id        String      @id @default(uuid()) @db.Uuid
  /// Null only for Global scope, which belongs to no tenant.
  tenantId  String?     @map("tenant_id") @db.Uuid
  key       String
  value     Json
  scope     ConfigScope
  scopeId   String?     @map("scope_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, scope, scopeId])
  @@index([tenantId, key])
  @@map("config_parameter")
}

enum OfflineCommandStatus {
  Pending
  Applied
  Rejected
}

/// Reasons a replayed command could not be applied (Authority: Bible V5 §2.C).
enum SyncConflictKind {
  /// Server-side state moved so preconditions no longer hold.
  StateConflict
  /// The target record was deleted while the client was offline.
  TargetDeleted
  /// The actor's permissions were revoked while they were offline.
  AuthorizationRevoked
  /// Optimistic concurrency lost against a newer server version.
  VersionConflict
}

/// The offline command inbox (Authority: Bible V5 §2.A, §2.B).
///
/// `commandId` is generated by the client, not the server, and carries the
/// uniqueness constraint. That is what makes replay exactly-once: a retry after
/// a network failure collides on insert and returns the stored result rather
/// than applying the mutation twice.
model OfflineCommand {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  /// Client-generated identity (Bible V5 §2.B.1).
  commandId       String               @map("command_id") @db.Uuid
  commandKey      String               @map("command_key")
  actorUserId     String               @map("actor_user_id") @db.Uuid
  payload         Json                 @default("{}")
  /// Replay order (Bible V5 §2.B.3) — the device's clock, not the server's.
  deviceTimestamp DateTime             @map("device_timestamp")
  status          OfflineCommandStatus @default(Pending)
  /// Cached result, returned verbatim on a duplicate submission.
  result          Json?
  error           String?
  receivedAt      DateTime             @default(now()) @map("received_at")
  appliedAt       DateTime?            @map("applied_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exceptions SyncException[]

  @@unique([tenantId, commandId])
  @@index([tenantId, status, deviceTimestamp])
  @@map("offline_command")
}

/// A replay that could not be applied and needs a human (Authority: Bible V5 §2.C).
///
/// Bible V5 requires an aborted replay to be flagged in the audit log and
/// enqueued for manual resolution rather than silently dropped — losing a
/// field worker's captured work is worse than surfacing a conflict.
model SyncException {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  offlineCommandId String           @map("offline_command_id") @db.Uuid
  kind             SyncConflictKind
  detail           String
  resolvedAt       DateTime?        @map("resolved_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offlineCommand OfflineCommand @relation(fields: [offlineCommandId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolvedAt])
  @@map("sync_exception")
}

/// A field whose visibility is restricted (Authority: Spec PLA-AUT-005).
///
/// GLOBAL capability metadata: which fields are sensitive is a property of the
/// entity, declared by its owning capability, not a per-tenant choice.
///
/// The presence of a row is what makes a field restricted. Reading it then
/// requires an ordinary Read grant on the field-qualified entity key
/// `<entityKey>#<fieldName>`, which reuses Verb+Entity+Scope exactly as it
/// stands. The specification's phrasing ("requires level 2 access") suggests a
/// numeric ladder; a ladder would be a second, parallel authorization model to
/// keep in sync with the first, so the existing grant mechanism is used instead.
model FieldPermission {
  id        String   @id @default(uuid()) @db.Uuid
  entityKey String   @map("entity_key")
  fieldName String   @map("field_name")
  createdAt DateTime @default(now()) @map("created_at")

  entity EntityDefinition @relation(fields: [entityKey], references: [key], onDelete: Cascade)

  @@unique([entityKey, fieldName])
  @@index([entityKey])
  @@map("field_permission")
}

// ===========================================================================
// CAPABILITY: Location  (verity.capability.location)
//
// Authority: ADR-004, which splits what a naive model would call "an address"
// into four distinct concepts and forbids folding them together:
//
//   Place    — real-world spatial identity (where something physically is)
//   Address  — the mailing representation (how you write to it)
//   Location — operational spatial context (where work happens)
//   Geofence — a spatial policy, not a place
//
// The split matters because a depot's postal address, the coordinates a
// technician navigates to, the operational site work is scheduled against, and
// the boundary that decides whether a check-in is valid are four different
// facts that change independently.
// ===========================================================================

/// Real-world spatial identity (ADR-004).
model Place {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  /// WGS84. Stored as Decimal, not Float: coordinate arithmetic on binary
  /// floating point accumulates error, and a geofence decision is a boundary
  /// comparison where that error changes the answer.
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses Address[]
  locations Location[]

  @@unique([tenantId, id], name: "place_tenant_scoped_id")
  @@index([tenantId])
  @@map("place")
}

/// Mailing representation (ADR-004). Deliberately separate from Place: a site
/// may have several postal addresses, or none, without changing where it is.
model Address {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  placeId      String?  @map("place_id") @db.Uuid
  line1        String
  line2        String?
  city         String?
  region       String?
  postalCode   String?  @map("postal_code")
  countryCode  String?  @map("country_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  place  Place? @relation(fields: [tenantId, placeId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId])
  @@map("address")
}

/// Operational spatial context — the site work is scheduled against
/// (ADR-004, GOV-TER-017). This is the entity a Location-scoped permission
/// grant resolves to.
model Location {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  placeId        String?  @map("place_id") @db.Uuid
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)
  customFields   Json     @default("{}") @map("custom_fields")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  place        Place?               @relation(fields: [tenantId, placeId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  geofences    Geofence[]
  assignments  LocationAssignment[]
  assets       Asset[]

  @@unique([tenantId, id], name: "location_tenant_scoped_id")
  @@index([tenantId, organizationId])
  @@map("location")
}

/// A spatial policy attached to a Location (ADR-004: "Geofences are policies,
/// not Locations themselves").
model Geofence {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  locationId   String   @map("location_id") @db.Uuid
  name         String
  centreLat    Decimal  @map("centre_lat") @db.Decimal(9, 6)
  centreLng    Decimal  @map("centre_lng") @db.Decimal(9, 6)
  radiusMetres Int      @map("radius_metres")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, locationId])
  @@map("geofence")
}

/// Binds a User to the Locations they work at.
///
/// This is what a `Location`-scoped permission grant resolves through: without
/// it the platform would have no way to answer "which sites are this actor's",
/// and a Location-scoped grant would reach nothing.
model LocationAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([tenantId, userId])
  @@map("location_assignment")
}

// ===========================================================================
// CAPABILITY: Asset  (verity.capability.asset)
//
// Authority: GOV-TER-009 (`Asset` — physical equipment/machinery), ADR-008
// (an Asset is one of the two things a Resource may be backed by).
//
// Demanded independently by Fleet Management, Medical Equipment Maintenance and
// Facilities. Note what is deliberately absent: no make, model, year, or any
// other equipment-specific column. Forbidden pattern #3 exists because VEDA put
// vehicle brand and model identifiers into a core table; those belong in
// custom_fields, where a fleet tenant and a hospital tenant can each describe
// their own equipment without the platform knowing either domain.
// ===========================================================================

model Asset {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Where the asset currently is. Null for an asset in transit or unassigned.
  locationId   String?  @map("location_id") @db.Uuid
  name         String
  /// Tenant-facing identifier — a fleet number, a serial, an asset tag.
  reference    String?
  state        String   @default("in_service")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location  Location?  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  resources Resource[]

  @@unique([tenantId, id], name: "asset_tenant_scoped_id")
  @@unique([tenantId, reference])
  @@index([tenantId, locationId])
  @@map("asset")
}

// ===========================================================================
// CAPABILITY: Evidence  (verity.capability.evidence)
//
// Authority: Bible V2 (Evidence as immutable field data — GPS, photos,
// signatures), EXE-AUD-003 (append-only), ADR-004 (spatial capture is a Place
// question, and a geofence is the policy that judges it).
//
// Demanded independently by Security Operations, Field Service, Drone
// Inspection and Medical Equipment Maintenance. Evidence is the reason the
// audit stream is append-only at trigger level: a calibration certificate or a
// proof-of-attendance photograph that can be edited later is not evidence.
// ===========================================================================

enum EvidenceKind {
  Photo
  Signature
  GeoPoint
  Document
  Reading
}

model Evidence {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  /// What this evidence is about — any capability's entity.
  entityKey    String       @map("entity_key")
  entityId     String       @map("entity_id") @db.Uuid
  kind         EvidenceKind
  /// Platform-managed artefact. Preferred over `uri`: a StoredFile has a frozen
  /// checksum, so the bytes behind the reference cannot later change.
  fileId       String?      @map("file_id") @db.Uuid
  /// External reference, for an artefact the platform does not host.
  uri          String?
  /// Captured coordinates, when the device supplied them.
  latitude     Decimal?     @db.Decimal(9, 6)
  longitude    Decimal?     @db.Decimal(9, 6)
  /// Device clock at capture — not server time, which may be much later for
  /// evidence captured offline.
  capturedAt   DateTime     @map("captured_at")
  capturedById String?      @map("captured_by_id") @db.Uuid
  /// Geofence this capture was judged against, and the verdict at capture time.
  geofenceId   String?      @map("geofence_id") @db.Uuid
  withinFence  Boolean?     @map("within_fence")
  payload      Json         @default("{}")
  recordedAt   DateTime     @default(now()) @map("recorded_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  file   StoredFile? @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([tenantId, entityKey, entityId])
  @@index([tenantId, capturedAt])
  @@map("evidence")
}

// ===========================================================================
// CAPABILITY: Scheduling  (verity.capability.scheduling)
//
// Authority: ADR-008, which fixed this shape so it would not have to be
// re-litigated: a Resource is a single schedulable unit backed by exactly one
// Party or Asset, and crews, pools and room sets are ResourceGroup
// compositions. Availability and conflict detection run against Resources only,
// so there is one implementation rather than two that must agree.
//
// Demanded independently by Staffing, Facilities, Field Service and Medical
// Equipment Maintenance.
// ===========================================================================

/// How a group resolves to its members when work is scheduled against it.
enum GroupSelection {
  /// Every member is required — a two-person crew where both must attend.
  AllOf
  /// Any one member satisfies it — a pool of interchangeable technicians.
  AnyOf
  /// A specific count drawn from the pool.
  NOf
}

/// A single schedulable unit (ADR-008).
///
/// Backed by exactly one Party or one Asset — never both, never neither. A
/// Resource backed by neither is unschedulable; one backed by both is
/// ambiguous. Enforced by a check constraint rather than by convention.
model Resource {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  partyId      String?  @map("party_id") @db.Uuid
  assetId      String?  @map("asset_id") @db.Uuid
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party        Party?                @relation(fields: [partyId], references: [id], onDelete: Restrict)
  asset        Asset?                @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  memberships  ResourceGroupMember[]
  availability AvailabilityWindow[]
  bookings     Booking[]

  @@unique([tenantId, id], name: "resource_tenant_scoped_id")
  @@index([tenantId])
  @@map("resource")
}

/// A composition of Resources — a crew, a pool, a room set (ADR-008).
///
/// A group has no calendar of its own; its availability is derived from its
/// members. That is what keeps conflict detection a single implementation.
model ResourceGroup {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String
  selection     GroupSelection @default(AnyOf)
  /// Only meaningful for NOf.
  requiredCount Int?           @map("required_count")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  version       Int            @default(1)
  customFields  Json           @default("{}") @map("custom_fields")

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members ResourceGroupMember[]

  @@unique([tenantId, id], name: "resource_group_tenant_scoped_id")
  @@index([tenantId])
  @@map("resource_group")
}

model ResourceGroupMember {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group    ResourceGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  resource Resource      @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([groupId, resourceId])
  @@index([tenantId])
  @@map("resource_group_member")
}

/// A window in which a Resource is or is not available.
model AvailabilityWindow {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  /// False marks an exception — leave, servicing, a closure.
  available  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, resourceId, startsAt])
  @@map("availability_window")
}

/// A Resource committed to a period of work.
///
/// `subjectEntityKey` / `subjectEntityId` point at whatever the booking is for,
/// so Scheduling never needs to know which capability asked.
model Booking {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  resourceId       String   @map("resource_id") @db.Uuid
  subjectEntityKey String   @map("subject_entity_key")
  subjectEntityId  String   @map("subject_entity_id") @db.Uuid
  startsAt         DateTime @map("starts_at")
  endsAt           DateTime @map("ends_at")
  cancelled        Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)
  customFields     Json     @default("{}") @map("custom_fields")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, resourceId, startsAt])
  @@map("booking")
}

// ===========================================================================
// CAPABILITY: Approval  (verity.capability.approval)
//
// Authority: foundation validation — demanded independently by Professional
// Services, Staffing, Finance and Procurement. A generic multi-step approval
// chain, so that four capabilities do not each grow their own.
// ===========================================================================

enum ApprovalDecision {
  Pending
  Approved
  Rejected
  Skipped
}

model ApprovalRequest {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  subjectEntityKey String           @map("subject_entity_key")
  subjectEntityId  String           @map("subject_entity_id") @db.Uuid
  requestedById    String           @map("requested_by_id") @db.Uuid
  state            String           @default("pending")
  outcome          ApprovalDecision @default(Pending)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  version          Int              @default(1)
  customFields     Json             @default("{}") @map("custom_fields")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps  ApprovalStep[]

  @@index([tenantId, subjectEntityKey, subjectEntityId])
  @@map("approval_request")
}

/// One step in a chain. Steps are ordered and decided in sequence.
model ApprovalStep {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  requestId       String           @map("request_id") @db.Uuid
  sequence        Int
  /// The role permitted to decide this step. Who approves is a role, not a
  /// person, so a chain survives someone leaving.
  approverRoleId  String           @map("approver_role_id") @db.Uuid
  decision        ApprovalDecision @default(Pending)
  decidedByUserId String?          @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?        @map("decided_at")
  comment         String?

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  role    Role            @relation(fields: [tenantId, approverRoleId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([requestId, sequence])
  @@index([tenantId])
  @@map("approval_step")
}

// ===========================================================================
// PLATFORM: Temporal model
//
// Authority: Bible V4 §5.B ("schedulers see time zones in local project
// contexts"), Bible V3 §1 (SLA clocks), EXE-SCH-001 (UTC storage with
// user-local translation).
//
// Every instant is stored in UTC. A timezone is a *rendering and reckoning*
// context, not a storage format: "9am local" means different instants in
// different places, and a business calendar cannot decide whether 08:30 is
// inside working hours without knowing whose clock is being read.
//
// The platform holds no default. Guessing a timezone silently misplaces every
// deadline by the offset, so an unconfigured tenant is explicitly UTC and the
// interface says so rather than pretending to know.
// ===========================================================================

/// Working-hours calendar used by SLA clocks (Bible V3 §1).
///
/// Tenant-scoped and optionally narrowed to an organization, because a
/// portfolio's branches genuinely keep different hours.
model BusinessCalendar {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// Null means the calendar applies tenant-wide.
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  /// IANA zone, e.g. "Europe/London". Never an offset: an offset cannot
  /// express daylight saving, so a fixed one is wrong for half the year.
  timeZone       String   @map("time_zone")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hours    BusinessHours[]
  holidays BusinessHoliday[]
  policies SlaPolicy[]

  @@unique([tenantId, name])
  @@unique([tenantId, id], name: "business_calendar_tenant_scoped_id")
  @@index([tenantId])
  @@map("business_calendar")
}

/// One working window on one weekday, in the calendar's own timezone.
model BusinessHours {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  calendarId  String @map("calendar_id") @db.Uuid
  /// 0 = Sunday through 6 = Saturday, matching JavaScript's getDay().
  weekday     Int
  /// Minutes from local midnight. Stored as minutes rather than a time so a
  /// window can cross into a 25-hour DST day without ambiguity.
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar BusinessCalendar @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, calendarId, weekday])
  @@map("business_hours")
}

/// A non-working date. Stored as a local date, not an instant, because a
/// holiday is a day in a place rather than a moment in time.
model BusinessHoliday {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  calendarId String @map("calendar_id") @db.Uuid
  /// ISO local date, e.g. "2026-12-25".
  localDate  String @map("local_date")
  name       String

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar BusinessCalendar @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([calendarId, localDate])
  @@index([tenantId])
  @@map("business_holiday")
}

// ===========================================================================
// PLATFORM: SLA substrate
//
// Authority: Bible V3 §1 [FACT] — the clock state machine is constitutional,
// MET-STA-004 (clocks evaluate at the StateCategory layer, ignoring label text).
//
// This is the reusable substrate only. It provides clocks, calendars, pause and
// breach semantics and an escalation hook. It defines no client's SLA policy and
// no domain workflow — a capability attaches a policy to its own entity and the
// platform runs the clock.
//
// The clock transitions are driven by StateCategory rather than by state keys,
// which is exactly why ADR-009 fixed a behavioural category set: Active runs the
// clock, Pending and Blocked pause it, Completed and Cancelled stop it, Draft
// has not started. A capability gets correct SLA behaviour by declaring its
// states honestly, without writing any clock code.
// ===========================================================================

enum SlaClockStatus {
  /// Target created, clock not yet started (Bible V3: INITIALIZE).
  NotStarted
  Running
  Paused
  /// Deadline passed while running.
  Breached
  /// Terminal; elapsed time frozen.
  Stopped
}

/// A reusable SLA policy owned by a capability's entity type.
model SlaPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// EntityDefinition.key this policy applies to.
  entityKey     String   @map("entity_key")
  name          String
  /// Working minutes allowed before breach.
  targetMinutes Int      @map("target_minutes")
  /// Null means elapsed wall-clock time; otherwise only working time counts.
  calendarId    String?  @map("calendar_id") @db.Uuid
  /// Higher wins when several policies match (Bible V3: contract SLA overrides
  /// tenant default; an explicit work-level deadline overrides both).
  precedence    Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  version       Int      @default(1)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar BusinessCalendar? @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  clocks   SlaClock[]

  @@unique([tenantId, name])
  @@unique([tenantId, id], name: "sla_policy_tenant_scoped_id")
  @@index([tenantId, entityKey])
  @@map("sla_policy")
}

/// A running clock against one record.
model SlaClock {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  policyId           String         @map("policy_id") @db.Uuid
  entityKey          String         @map("entity_key")
  entityId           String         @map("entity_id") @db.Uuid
  status             SlaClockStatus @default(NotStarted)
  /// Working minutes consumed while running. Accumulated on pause and stop so
  /// the figure survives a restart and needs no replay to compute.
  elapsedMinutes     Int            @default(0) @map("elapsed_minutes")
  /// When the current running segment began; null unless Running.
  runningSince       DateTime?      @map("running_since")
  /// Computed when the clock starts or resumes. An explicit override wins
  /// (Bible V3 precedence rule 2).
  deadlineAt         DateTime?      @map("deadline_at")
  overrideDeadlineAt DateTime?      @map("override_deadline_at")
  breachedAt         DateTime?      @map("breached_at")
  stoppedAt          DateTime?      @map("stopped_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  version            Int            @default(1)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy SlaPolicy @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([policyId, entityKey, entityId])
  @@index([tenantId, status])
  @@index([tenantId, deadlineAt])
  @@map("sla_clock")
}

// ===========================================================================
// PLATFORM: Files and documents
//
// Authority: PLA-CFG-002 (DocumentTemplate as a declarative template),
// EXE-AUD-003 (evidence artefacts must not be silently replaced), Bible V5 §1
// (tenant isolation applies to stored objects as much as to rows).
//
// The platform owns the *record* of a file — who uploaded it, what it is, which
// record it belongs to, whether it is still pending — and delegates the bytes to
// a storage driver. Keeping the record separate from the bytes is what lets
// authorization, audit and retention work uniformly regardless of where the
// object physically lives.
// ===========================================================================

enum StoredFileStatus {
  /// Record created, bytes not yet confirmed. A file is never readable in this
  /// state: an unconfirmed upload may be absent, partial, or someone else's.
  Pending
  Stored
  /// Failed a post-upload check. Kept, never served.
  Quarantined
}

model StoredFile {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  /// Opaque key in the storage backend. Namespaced by tenant so a driver
  /// misconfiguration cannot cross the boundary silently.
  storageKey   String           @map("storage_key")
  fileName     String           @map("file_name")
  mimeType     String           @map("mime_type")
  byteSize     Int              @map("byte_size")
  /// Content hash, recorded at confirmation. Two records with the same checksum
  /// are the same bytes, which is what makes an artefact reference verifiable.
  checksum     String?
  status       StoredFileStatus @default(Pending)
  uploadedById String?          @map("uploaded_by_id") @db.Uuid
  /// What the file is about, so authorization can be derived from the subject
  /// rather than duplicated onto the file.
  entityKey    String?          @map("entity_key")
  entityId     String?          @map("entity_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  confirmedAt  DateTime?        @map("confirmed_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@unique([tenantId, storageKey])
  @@index([tenantId, entityKey, entityId])
  @@map("stored_file")
}

// ===========================================================================
// PLATFORM: Notifications
//
// Authority: PLA-CFG-002 (NotificationTemplate as a declarative template),
// MET-EVE-001→002 (events drive automations and notifications).
//
// A capability raises a notification; the platform decides how it reaches
// someone. Channels, preferences and templates are platform concerns because
// every capability needs them and none should implement its own.
//
// Deliberately not a messaging product: no threads, no read receipts beyond a
// timestamp, no delivery guarantees the platform cannot keep.
// ===========================================================================

enum NotificationChannel {
  InApp
  Email
  Push
  Webhook
}

enum NotificationStatus {
  Pending
  Sent
  Failed
  /// Suppressed by the recipient's preferences. Recorded rather than dropped,
  /// so "why did nobody get told" is answerable.
  Suppressed
}

/// A tenant-authored message template (PLA-CFG-002).
///
/// Placeholders are `{name}` and substitution is literal. A full expression
/// language would make a stored template executable, which is a step the
/// specification never asks for and a risk it does not weigh.
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  /// Stable key a capability refers to, e.g. `verity.approval.awaiting`.
  key       String
  channel   NotificationChannel
  subject   String
  body      String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  version   Int                 @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, channel])
  @@index([tenantId])
  @@map("notification_template")
}

/// Per-recipient channel preferences. Absence means the platform default.
model NotificationPreference {
  id       String              @id @default(uuid()) @db.Uuid
  tenantId String              @map("tenant_id") @db.Uuid
  userId   String              @map("user_id") @db.Uuid
  /// Notification key, or `*` for every notification on this channel.
  key      String              @default("*")
  channel  NotificationChannel
  enabled  Boolean             @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, channel])
  @@index([tenantId, userId])
  @@map("notification_preference")
}

/// One notification to one recipient on one channel.
///
/// Written inside the raising command's transaction for the same reason events
/// are: a notification about work that rolled back is a lie.
model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  recipientId String              @map("recipient_id") @db.Uuid
  key         String
  channel     NotificationChannel
  status      NotificationStatus  @default(Pending)
  subject     String
  body        String
  /// What it concerns, so the interface can link to the record.
  entityKey   String?             @map("entity_key")
  entityId    String?             @map("entity_id") @db.Uuid
  readAt      DateTime?           @map("read_at")
  sentAt      DateTime?           @map("sent_at")
  failure     String?
  createdAt   DateTime            @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipientId, readAt])
  @@index([tenantId, status])
  @@map("notification")
}

// ===========================================================================
// CAPABILITY: Dine-in  (verity.capability.dinein)
//
// Kent's Restaurant, Defence Colony — the first real client requirement.
// Authority: KentsRestaurant.md §6, implementation/kents-gap-analysis.md.
//
// Capability-owned, which PLATFORM-FREEZE names as expected and additive: new
// tables under a capability's own name change nothing about tenancy, the
// command runtime, authorization or the shell. Every model below carries the
// base-entity shape (id, tenantId, createdAt, updatedAt, version, customFields)
// and is protected by the same RLS policy as every other tenant-scoped table.
//
// MONEY IS INTEGER MINOR UNITS (paise). Floating-point money drifts by the
// third addition, and a bill that disagrees with itself by a paisa is a bill
// nobody trusts. Currency comes from configuration; the arithmetic does not.
// ===========================================================================

/// A section of the menu — Starters, Breads, Desserts.
model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@unique([tenantId, name])
  @@unique([tenantId, id], name: "menu_category_tenant_scoped_id")
  @@index([tenantId, sortOrder])
  @@map("menu_category")
}

/// Something orderable, with the price it is sold at today.
///
/// Never deleted — retired through `active`, because a bill from last month must
/// still render what was charged. Order lines snapshot name and price anyway;
/// this keeps the catalogue honest as well as the history.
model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String
  description  String?
  priceMinor   Int      @map("price_minor")
  /// What the item costs the kitchen. Restricted by FieldPermission so margin
  /// never reaches a shared floor tablet.
  costMinor    Int?     @map("cost_minor")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category MenuCategory      @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  variants MenuItemVariant[]
  lines    OrderLine[]

  @@unique([tenantId, id], name: "menu_item_tenant_scoped_id")
  @@index([tenantId, categoryId, sortOrder])
  @@map("menu_item")
}

/// A portion of an item — Half, Full — priced as a delta from the item.
model MenuItemVariant {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
  name            String
  priceDeltaMinor Int      @default(0) @map("price_delta_minor")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  version         Int      @default(1)
  customFields    Json     @default("{}") @map("custom_fields")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   MenuItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, itemId, name])
  @@unique([tenantId, id], name: "menu_variant_tenant_scoped_id")
  @@map("menu_variant")
}

/// A part of the floor — Ground, Mezzanine, Terrace.
model DiningZone {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  floorLabel   String?  @map("floor_label")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables DiningTable[]

  @@unique([tenantId, name])
  @@unique([tenantId, id], name: "dining_zone_tenant_scoped_id")
  @@map("dining_zone")
}

/// A physical table, where it sits on the floor plan, and what it is doing.
///
/// Not a Resource and not an Asset (ADR-008 considered and rejected in
/// KentsRestaurant.md §6 M2): occupancy is discrete state, not calendar
/// scheduling, and double-seating is prevented by the occupy precondition
/// rather than by an overlap trigger.
model DiningTable {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  zoneId       String   @map("zone_id") @db.Uuid
  label        String
  seats        Int      @default(2)
  shape        String?
  /// Floor-plan canvas coordinates. Real numbers a manager dragged, not a
  /// generic diagram abstraction.
  posX         Int      @default(0) @map("pos_x")
  posY         Int      @default(0) @map("pos_y")
  state        String   @default("available")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zone   DiningZone    @relation(fields: [tenantId, zoneId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  orders DiningOrder[]

  @@unique([tenantId, label])
  @@unique([tenantId, id], name: "dining_table_tenant_scoped_id")
  @@index([tenantId, state])
  @@map("dining_table")
}

/// One table's service, from cart to settled.
///
/// This is the domain's Work instance (Bible V2 WORK): a unit of service
/// execution moving through states under commands. Called an order because that
/// is what a restaurant calls it — never a ticket, job card or event run.
model DiningOrder {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tableId       String    @map("table_id") @db.Uuid
  /// Resolved from the session, never from a payload (PLA-TEN-006).
  takenByUserId String    @map("taken_by_user_id") @db.Uuid
  covers        Int       @default(1)
  state         String    @default("draft")
  /// Plain fields for the occasional B2B invoice. Deliberately NOT a Party — a
  /// walk-in diner has no login and must not mint a platform identity
  /// (ADR-001, ADR-007).
  customerName  String?   @map("customer_name")
  customerPhone String?   @map("customer_phone")
  placedAt      DateTime? @map("placed_at")
  servedAt      DateTime? @map("served_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  version       Int       @default(1)
  customFields  Json      @default("{}") @map("custom_fields")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table  DiningTable @relation(fields: [tenantId, tableId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  lines  OrderLine[]
  bill   Bill?

  @@unique([tenantId, id], name: "dining_order_tenant_scoped_id")
  @@index([tenantId, state])
  @@index([tenantId, tableId, state])
  @@map("dining_order")
}

/// One line on an order, with its own progress through the kitchen.
///
/// A twelve-item order is not done when one dish is, which is why the line —
/// not the order — is what the kitchen advances.
///
/// Name and price are SNAPSHOTS. Menu edits are forward-looking; a bill from
/// last month must render exactly what was charged even after the item is
/// renamed, repriced or retired. Same principle as Evidence immutability.
model OrderLine {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  itemId              String   @map("item_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  itemNameSnapshot    String   @map("item_name_snapshot")
  variantNameSnapshot String?  @map("variant_name_snapshot")
  unitPriceMinor      Int      @map("unit_price_minor")
  qty                 Int      @default(1)
  lineNote            String?  @map("line_note")
  state               String   @default("queued")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  version             Int      @default(1)
  customFields        Json     @default("{}") @map("custom_fields")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  DiningOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  item   MenuItem    @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id], name: "order_line_tenant_scoped_id")
  @@index([tenantId, orderId])
  @@index([tenantId, state])
  @@map("order_line")
}

/// The guest's bill for one order.
///
/// Amounts are computed once, server-side, at generation — including the tax
/// breakdown, which is stored rather than recomputed on render, so a reprint a
/// year later shows the rate that actually applied.
model Bill {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  orderId           String    @unique @map("order_id") @db.Uuid
  subtotalMinor     Int       @map("subtotal_minor")
  discountMinor     Int       @default(0) @map("discount_minor")
  /// The tax that applied, in columns rather than a JSON blob.
  ///
  /// An Indian restaurant bill for an intra-state supply carries exactly two
  /// components, so two pairs of columns model it completely. The rate is stored
  /// beside the amount because PRN-001 requires the math be visible on the bill,
  /// and because a reprint a year later must show the rate that actually
  /// applied rather than today's.
  ///
  /// Rates are BASIS POINTS: 2.5% is 250. Integer money deserves integer rates,
  /// and a float rate would reintroduce on the tax line exactly the drift the
  /// paise columns exist to avoid.
  cgstRateBp        Int       @default(0) @map("cgst_rate_bp")
  cgstMinor         Int       @default(0) @map("cgst_minor")
  sgstRateBp        Int       @default(0) @map("sgst_rate_bp")
  sgstMinor         Int       @default(0) @map("sgst_minor")
  taxableMinor      Int       @default(0) @map("taxable_minor")
  totalMinor        Int       @map("total_minor")
  roundingMinor     Int       @default(0) @map("rounding_minor")
  state             String    @default("open")
  generatedByUserId String    @map("generated_by_user_id") @db.Uuid
  settledAt         DateTime? @map("settled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(1)
  customFields      Json      @default("{}") @map("custom_fields")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    DiningOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  payments Payment[]

  // One bill per order in v1. The pair is unique as well as the id, because the
  // relation is defined on the tenant-scoped composite key and Prisma needs the
  // defining side of a one-to-one to be unique on exactly those columns.
  @@unique([tenantId, orderId], name: "bill_tenant_scoped_order")
  @@unique([tenantId, id], name: "bill_tenant_scoped_id")
  @@index([tenantId, state])
  @@map("bill")
}

/// Money received against a bill. Several rows settle a split payment.
model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  billId           String   @map("bill_id") @db.Uuid
  method           String
  amountMinor      Int      @map("amount_minor")
  /// UPI transaction id or card reference. Record-and-print only: no terminal
  /// integration, no gateway (GOV-SCO-006).
  reference        String?
  receivedByUserId String   @map("received_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)
  customFields     Json     @default("{}") @map("custom_fields")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill   Bill   @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, id], name: "payment_tenant_scoped_id")
  @@index([tenantId, billId])
  @@map("payment")
}
