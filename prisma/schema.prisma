generator client {
  provider = "prisma-client-js"
  // `relationJoins` lets a query opt into a single SQL LATERAL JOIN instead of
  // one round trip per nested relation. The deep salesOrder include is seven
  // levels deep and cost ~11 round trips — 2.4s against a database 220ms away.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // App runtime uses the pooled connection (pgbouncer). Migrations need a
  // direct, non-pooled connection — required by Supabase/Neon poolers.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum BomMode {
  OFF
  RECIPE
  INGREDIENTS
}

enum ItemType {
  RAW_MATERIAL
  SEMI_FINISHED
  FINISHED_PRODUCT
  CONSUMABLE
  PACKAGING
  SPARE_PART
  MACHINERY
  TOOL
  ASSET
  SERVICE
}

// The owner-defined item tree: six seeded roots (Raw Material, Semi-Finished,
// Finished Good, Consumable, Packaging, Trading Goods) with any depth of
// subgroups beneath them. A group carries the spec fields its items answer and
// the templates that turn those answers into a name and a code.
model ItemGroup {
  id                String              @id @default(cuid())
  factoryId         String
  parentId          String?
  parent            ItemGroup?          @relation("ItemGroupTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          ItemGroup[]         @relation("ItemGroupTree")
  name              String
  // Feeds {group} in code templates, e.g. "SC" for Seat Cover.
  shortCode         String?
  // Root groups define the type; children inherit it at read time.
  itemType          ItemType
  nameTemplate      String?
  codeTemplate      String?
  /// Per-group headers for the three built-in columns. Null means "use the
  /// default word". The row's identity columns cannot be hidden; the alias can,
  /// because record sheets reuse that slot for their own meaning.
  codeLabel         String?
  nameLabel         String?
  aliasLabel        String?
  aliasHidden       Boolean             @default(false)
  isProducible      Boolean             @default(false)
  isPurchasable     Boolean             @default(false)
  isSalable         Boolean             @default(false)
  hasBOM            Boolean             @default(false)
  hasQC             Boolean             @default(false)
  hasRouting        Boolean             @default(false)
  hasCAD            Boolean             @default(false)
  /// Whether this category's items are physically stocked and bought — i.e. do
  /// they need units, conversions and an alias at all. Vehicles, Brands, Designs
  /// and Colours are attributes, not stock: their SKU form hides Identity &
  /// Units, and the BOM component search skips them.
  hasInventoryUnits Boolean             @default(true)
  /// Which BOM editor this category's items get, and what the wizard's BOM
  /// button writes.
  ///
  /// This used to be inferred — isProducible AND stocked AND not bought meant
  /// "recipe", a category nothing referenced meant "neither" — which was a
  /// guess about the factory's intent dressed up as a rule. A factory that
  /// wants recipes on its raw materials, or ingredients on a semi-finished
  /// good, now says so instead of fighting the inference.
  ///
  /// OFF          no BOM editor at all
  /// RECIPE       an assembly recipe of its own, plus per-SKU overrides
  /// INGREDIENTS  components it hands to whatever picks it
  ///
  /// Nullable, and null does NOT mean OFF — it means "inherit from my parent",
  /// resolved by `resolveBomMode`. A factory that sets RECIPE on "Seat Covers"
  /// wants it on "Seat Covers > Bucket" too, and previously had to set it on
  /// every child and keep them in step. Existing rows hold an explicit OFF and
  /// are unaffected; only categories created after this can inherit.
  bomMode           BomMode?
  /// A checklist any category can carry, not only producible ones — and not
  /// only for QC. Cutting and Packing run one too.
  /// Many-to-many: a category runs one checklist per department, so "Seat Cover"
  /// is on the Cutting list and the Stitching list at the same time. A single FK
  /// here meant ticking it on one template silently unticked it everywhere else.
  defaultChecklists ChecklistTemplate[] @relation("ItemGroupDefaultChecklist")
  /// Ordered departments copied into BlueprintRouteStep at item creation:
  /// [{ departmentId, estimatedTimeMins }]. A list, not a table —
  /// BlueprintRouteStep already carries the real per-step shape.
  defaultRouteJson  Json?
  // Root groups render as a tab in the Master Data Studio.
  isSheet           Boolean             @default(false)
  /// Seeded roots the backend depends on (Finished Good, Raw Material, ...).
  /// They may be renamed for the factory's own vocabulary, but never deleted and
  /// never retyped: order booking, stock and production all key off their type.
  isSystem          Boolean             @default(false)
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  specFields       SpecField[]
  referencedBy     SpecField[]       @relation("SpecFieldTarget")
  items            ItemMaster[]
  bomTemplateLines BomTemplateLine[]

  @@unique([factoryId, parentId, name])
  @@index([factoryId])
}

enum SpecFieldKind {
  VALUE
  OPTION
  REFERENCE
}

/// What a REFERENCE field points at. ITEM_GROUP resolves to ItemMaster rows in
/// that group; every other value resolves to an attribute master.
enum SpecRefTarget {
  ITEM_GROUP
  VEHICLE_BRAND
  VEHICLE_MODEL
  VEHICLE_GENERATION
  DESIGN
  COLOR
  SUPPLIER
  CUSTOMER
  WAREHOUSE
  WAREHOUSE_BIN
  EMPLOYEE
  DEPARTMENT
  MACHINE
}

// One field on a group's spec sheet. Inherited by every descendant group, so
// "GSM" defined on Fabric is answered by Leatherite and Suede items too.
model SpecField {
  id         String        @id @default(cuid())
  factoryId  String
  groupId    String
  group      ItemGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  /// Token used in name/code templates, e.g. "brand" for {brand}.
  key        String
  kind       SpecFieldKind
  /// VALUE only. Reuses the existing FieldType enum.
  valueType  FieldType?
  /// VALUE only. Rendered after the value: 4 + "HDR" -> "4HDR".
  unitSuffix String?

  /// REFERENCE only.
  refTarget          SpecRefTarget?
  targetGroupId      String?
  targetGroup        ItemGroup?     @relation("SpecFieldTarget", fields: [targetGroupId], references: [id], onDelete: Restrict)
  includeDescendants Boolean        @default(true)
  /// REFERENCE only. Which column of the target category this picks from.
  ///
  /// Null keeps the original behaviour: pick a whole record, shown by its name.
  /// Set means the dropdown offers that column's values instead — a Seat Cover
  /// linking to Vehicle > Car and showing its Brand column offers Tata and
  /// Maruti, not the vehicles themselves.
  ///
  /// Restrict, not SetNull: silently falling back to the record list would put
  /// every vehicle in a dropdown that has only ever shown brands, and the owner
  /// would have no idea why.
  targetFieldId      String?
  targetField        SpecField?     @relation("SpecFieldColumn", fields: [targetFieldId], references: [id], onDelete: Restrict)
  displayedBy        SpecField[]    @relation("SpecFieldColumn")
  dependsOnFieldId   String?
  dependsOn          SpecField?     @relation("SpecFieldDeps", fields: [dependsOnFieldId], references: [id], onDelete: SetNull)
  dependents         SpecField[]    @relation("SpecFieldDeps")

  isRequired Boolean   @default(false)
  sortOrder  Int       @default(0)
  /// Soft delete. Archived fields keep their stored answers.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  options                     SpecFieldOption[]
  values                      ItemFieldValue[]
  bomLines                    BomTemplateLine[] @relation("BomTemplateSourceField")
  bomTemplateQuantityFrom     BomTemplateLine[] @relation("BomTemplateQuantityFrom")
  bomTemplateQuantityVia      BomTemplateLine[] @relation("BomTemplateQuantityVia")
  bomContributionSlots        BomContribution[] @relation("BomContributionSource")
  bomContributionQuantityFrom BomContribution[] @relation("BomContributionQuantityFrom")

  @@unique([groupId, key])
  @@index([factoryId])
}

model SpecFieldOption {
  id        String    @id @default(cuid())
  fieldId   String
  field     SpecField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  /// Stored identity.
  value     String
  /// Shown in the dropdown and printed by the name template.
  label     String
  /// Printed by the code template, e.g. "DB".
  shortCode String?
  sortOrder Int       @default(0)

  values        ItemFieldValue[]
  contributions BomContribution[]

  @@unique([fieldId, value])
}

enum QCStatus {
  PENDING
  IN_PROGRESS
  WAITING_QC
  APPROVED
  REJECTED
  REWORK_REQUIRED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  ACTION_REQUIRED
}

enum TimelineEventType {
  CREATED
  UPDATED
  APPROVED
  REJECTED
  STATUS_CHANGED
  COMMENT_ADDED
  FILE_ATTACHED
}

// ==========================================
// IDENTITY ENGINE
// ==========================================

model Factory {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  logoUrl          String?
  address          String?
  industry         String?
  settings         Json?    @default("{}")
  onboardingStatus String   @default("SETUP")
  setupFee         Int      @default(0)
  monthlyFee       Int      @default(0)
  modulesEnabled   String?  @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users           User[]
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments     Department[]
  agreements      Agreement[]
  supportSessions SupportSession[]
  workflowStages  WorkflowStage[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  diningTables    RestaurantTable[]
  diningOrders    DiningOrder[]
  diningBills     DiningBill[]

  @@index([organizationId])
}

model Agreement {
  id          String    @id @default(cuid())
  factoryId   String?
  factoryName String
  ownerName   String
  phone       String
  modules     Json      @default("[]") // Array of strings of enabled modules
  setupFee    Int       @default(0)
  monthlyFee  Int       @default(0)
  status      String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, EXPIRED
  acceptedAt  DateTime?
  signature   String?
  createdBy   String // ID of the internal user who created it
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  factory Factory? @relation(fields: [factoryId], references: [id], onDelete: SetNull)

  @@index([factoryId])
}

model SupportSession {
  id             String    @id @default(cuid())
  factoryId      String
  internalUserId String
  reason         String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Restrict)

  @@index([factoryId])
  @@index([internalUserId])
}

model WorkflowStage {
  id             String   @id @default(cuid())
  factoryId      String
  name           String // e.g., "Design", "Cutting", "Stitching", "QC Check"
  sortOrder      Int      @default(0)
  requirePhoto   Boolean  @default(false)
  requireRemarks Boolean  @default(false)
  isQcStage      Boolean  @default(false) // QC stages run the inspection flow instead of stage capture
  assignedRole   Role?    @relation(fields: [roleId], references: [id]) // Role allowed to complete this stage
  qcTemplateId   String? // Optional template to check during this stage
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  factory  Factory   @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  jobCards JobCard[]
  roleId   String?

  @@index([factoryId])
}

model User {
  id                String     @id @default(cuid())
  factoryId         String
  factory           Factory    @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  authId            String?    @unique
  name              String
  employeeId        Int        @unique @default(autoincrement())
  phone             String?    @unique
  role              SystemRole
  roleId            String?
  customRole        Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status            String     @default("active")
  pinHash           String?
  email             String?
  notificationPrefs Json? // { email: bool, whatsapp: bool } — in-app always on
  language          String     @default("en")
  customFields      Json?      @default("{}")
  themePreference   String     @default("system")
  isActive          Boolean    @default(true)
  failedAttempts    Int        @default(0)
  lockedUntil       DateTime?
  createdById       String?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  employeeProfile EmployeeProfile?
  notifications   Notification[]
  jobCards        JobCard[]
  inspectedOrders SalesOrder[]     @relation("OrderInspector")

  // A worker/inspector belongs to one department (the stage they staff). Role
  // distinguishes worker vs inspector within that department.
  departmentId String?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)

  // Service-module back-relations. Each is named because a User can stand in
  // several roles against the same table (requester vs. replacement on a swap,
  // reporter vs. assignee on a ticket) and Prisma cannot infer which is which.
  managedSites      Site[]                @relation("SiteManager")
  siteDeployments   SiteDeployment[]      @relation("SiteDeploymentUser")
  assignedTickets   Ticket[]              @relation("TicketAssignee")
  reportedTickets   Ticket[]              @relation("TicketReporter")
  ticketComments    TicketComment[]       @relation("TicketCommentAuthor")
  serviceWorkOrders ServiceWorkOrder[]    @relation("ServiceWOAssignee")
  managedProjects   Project[]             @relation("ProjectManager")
  assignedTasks     Task[]                @relation("TaskAssignee")
  timesheetEntries  TimesheetEntry[]      @relation("TimesheetUser")
  assignedAssets    Asset[]               @relation("AssetAssignee")
  maintenanceLogs   AssetMaintenanceLog[] @relation("MaintenancePerformer")
  shiftSchedules    ShiftSchedule[]       @relation("ShiftScheduleUser")
  requestedSwaps    ShiftSwap[]           @relation("SwapRequester")
  offeredSwaps      ShiftSwap[]           @relation("SwapRecipient")
  payrollInputs     PayrollInput[]        @relation("PayrollInputUser")
  orderDrafts       OrderDraft[]          @relation("OrderDraftAuthor")
}

// ==========================================
// FACTORY SETUP (Master Data)
// ==========================================

// A department is a stage in the production chain (CAD → Cutting → Stitching →
// QC → Packing) AND the roster of workers/inspectors who staff it. sortOrder is
// the chain position; isQcStage routes the card through the inspection flow; a
// template gives the stage a QC-style checklist the worker completes.
model Department {
  id               String   @id @default(cuid())
  factoryId        String
  factory          Factory  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  name             String // Cutting, Stitching, QC, Packing, etc.
  description      String?
  sortOrder        Int      @default(0)
  isQcStage        Boolean  @default(false)
  requirePhoto     Boolean  @default(false)
  requireRemarks   Boolean  @default(false)
  // When true, a worker's stage completion waits for the department supervisor
  // to approve before the chain advances (QC-style sign-off for any department).
  // This is the standard flow — worker submits, supervisor approves, the job
  // moves to the next department — so new departments opt in by default.
  requiresApproval Boolean  @default(true)
  active           Boolean  @default(true)
  capacity         Float?
  createdAt        DateTime @default(now())

  members        User[]               @relation("DepartmentMembers")
  jobCards       JobCard[]
  routeSteps     BlueprintRouteStep[]
  /// Checklist templates dedicated to this department.
  ownedTemplates ChecklistTemplate[]  @relation("DepartmentTemplates")

  @@unique([factoryId, name])
  @@index([factoryId])
}

// ==========================================
// SHARED PLATFORM LAYER
// ==========================================

model TimelineEvent {
  id          String            @id @default(cuid())
  factoryId   String
  entityType  String // e.g., "WorkOrder", "SalesOrder"
  entityId    String
  eventType   TimelineEventType
  title       String
  description String?           @db.Text
  actorId     String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([factoryId])
  @@index([entityType, entityId])
}

model Comment {
  id         String   @id @default(cuid())
  factoryId  String
  entityType String
  entityId   String
  authorId   String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([factoryId])
  @@index([entityType, entityId])
}

model Attachment {
  id         String   @id @default(cuid())
  factoryId  String
  entityType String
  entityId   String
  fileName   String
  fileUrl    String
  mimeType   String
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([factoryId])
  @@index([entityType, entityId])
}

model Notification {
  id        String           @id @default(cuid())
  factoryId String
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())

  @@index([factoryId])
  @@index([userId, read])
}

model AuditLog {
  id          String   @id @default(cuid())
  factoryId   String
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([factoryId])
  @@index([entityType, entityId])
}

model Approval {
  id            String    @id @default(cuid())
  factoryId     String
  entityType    String // e.g., "PurchaseOrder"
  entityId      String
  requestedById String
  approverId    String? // If assigned to a specific user
  approverRole  Role?     @relation(fields: [roleId], references: [id]) // Or assigned to any user with this role
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  comments      String?   @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  roleId        String?

  @@index([factoryId])
  @@index([entityType, entityId])
}

// ==========================================
// INVENTORY ENGINE (Material Movement)
// ==========================================

model ItemMaster {
  id              String               @id @default(cuid())
  factoryId       String
  name            String
  sku             String               @unique
  // Human master code (RM-00042, FG-00007...). Auto-generated, editable, unique
  // per factory. Nullable so existing rows migrate cleanly; CRUD always sets it.
  itemCode        String?
  itemType        ItemType
  defaultUOM      String
  secondaryUOM    String?
  brand           String?
  description     String?
  imageUrl        String?
  aliasName       String?
  searchKeywords  String[]             @default([])
  status          String               @default("ACTIVE") // ACTIVE | INACTIVE
  valuationMethod String               @default("FIFO")
  isBatchTracked  Boolean              @default(false)
  minStockLevel   Float                @default(0)
  safetyStock     Float                @default(0)
  hsnCode         String?
  taxRate         Float                @default(0)
  categoryId      String?
  category        MaterialCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId   String?
  subcategory     MaterialSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  // Owner-defined custom fields (e.g. "xyz"): values keyed by ItemFieldDefinition.id.
  customFields    Json?                @default("{}")

  // Spec engine. The group supplies the fields this item answers, the name and
  // code templates, and (later) the BOM template.
  groupId           String?
  group             ItemGroup?        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  manufacturingType ManufacturingType @default(BUY)
  /// Stable hash of (groupId, all answers). The item's real identity.
  specHash          String?

  conversions               UOMConversion[]
  stockLedgerEntries        StockLedgerEntry[]
  binBalances               BinBalance[]
  bomItems                  BOMItem[]             @relation("MaterialUsed")
  purchaseOrderItems        PurchaseOrderItem[]
  salesOrders               SalesOrder[]          @relation("OrderMaterial")
  salesOrdersAsColour       SalesOrder[]          @relation("OrderColour")
  salesOrdersAsDesign       SalesOrder[]          @relation("OrderDesign")
  salesOrdersAsVehicleBrand SalesOrder[]          @relation("OrderVehicleBrand")
  salesOrdersAsVehicleModel SalesOrder[]          @relation("OrderVehicleModel")
  reservations              MaterialReservation[] @relation("ReservedMaterial")
  specValues                ItemFieldValue[]
  referencedBy              ItemFieldValue[]      @relation("SpecItemRef")
  bomTemplateLines          BomTemplateLine[]     @relation("BomTemplateItem")
  bomContributedBy          BomContribution[]     @relation("BomContributionOwner")
  bomContributesTo          BomContribution[]     @relation("BomContributionComponent")
  bomOverrides              ItemBomOverride[]     @relation("ItemBomOverrideOwner")
  bomOverriddenIn           ItemBomOverride[]     @relation("ItemBomOverrideComponent")
  blueprint                 Blueprint?
  salesOrdersAsItem         SalesOrder[]          @relation("OrderItem")
  salesOrderLines           SalesOrderItem[]      @relation("SalesOrderLineItem")

  @@unique([factoryId, itemCode])
  @@unique([factoryId, specHash])
  @@index([factoryId])
  @@index([groupId])
}

/// Decides whether an item has a BOM. Not derivable from ItemType: a
/// consumable is bought, a semi-finished is made, some items are both.
enum ManufacturingType {
  MAKE
  BUY
  BOTH
}

// One answer to one spec field. Normalized rather than a JSON blob so that
// "every item using Leatherite Beige" is a join, and so item references carry a
// real foreign key.
model ItemFieldValue {
  id        String     @id @default(cuid())
  factoryId String
  itemId    String
  item      ItemMaster @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fieldId   String
  field     SpecField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  valueText   String?
  valueNumber Float?
  valueBool   Boolean?

  optionId String?
  option   SpecFieldOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)

  /// REFERENCE to another item. Real FK — these become BOM lines.
  valueItemId String?
  valueItem   ItemMaster? @relation("SpecItemRef", fields: [valueItemId], references: [id], onDelete: Restrict)

  /// REFERENCE to an attribute master (vehicle/design/colour). No FK is possible
  /// because the target table varies by SpecField.refTarget.
  valueRefId String?

  @@unique([itemId, fieldId])
  @@index([valueItemId])
  @@index([factoryId, fieldId])
}

// A line in a group's BOM recipe. The component is either a fixed item or
// whatever item was answered in a reference field — which is what lets filling
// the spec produce the bill of materials.
model BomTemplateLine {
  id        String    @id @default(cuid())
  factoryId String
  groupId   String
  group     ItemGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// Fixed component.
  itemId String?
  item   ItemMaster? @relation("BomTemplateItem", fields: [itemId], references: [id], onDelete: Restrict)

  /// Component taken from a reference field's answer.
  sourceFieldId String?
  sourceField   SpecField? @relation("BomTemplateSourceField", fields: [sourceFieldId], references: [id], onDelete: Cascade)

  quantity     Float   @default(1)
  /// When set, quantity comes from the named source instead of the fixed value.
  /// Supported: "design.fabricConsumption".
  quantityFrom String?
  wastePercent Float   @default(0)
  sortOrder    Int     @default(0)

  quantityFromFieldId String?
  quantityFromField   SpecField? @relation("BomTemplateQuantityFrom", fields: [quantityFromFieldId], references: [id], onDelete: SetNull)

  quantityViaFieldId String?
  quantityViaField   SpecField? @relation("BomTemplateQuantityVia", fields: [quantityViaFieldId], references: [id], onDelete: SetNull)

  @@index([factoryId])
  @@index([groupId])
}

/// A component brought in by *choosing a value*, rather than by belonging to a
/// category.
///
/// This is SAP's object dependency, minus the rule language: instead of writing
/// a condition on a BOM line, the owner attaches the component to the value that
/// requires it. Picking the design "ERGO FIT Vertex" on any finished good brings
/// its piping and thread along, entered once and reused across every vehicle.
///
/// Deliberately not restricted to designs. If a fabric turns out to need a
/// backing sheet, the owner attaches it to that fabric and it composes in — being
/// wrong about which kinds of value carry components is a likelier failure than
/// the owner misusing the freedom.
model BomContribution {
  id        String @id @default(cuid())
  factoryId String

  /// Exactly one of these owns the contribution — enforced in the action, since
  /// the DB cannot express "exactly one of three".
  /// A chosen option, e.g. "With Armrest".
  optionId    String?
  option      SpecFieldOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  /// A referenced master record, e.g. a Design.
  refId       String?
  /// A specific item, e.g. the fabric Suede Grey.
  ownerItemId String?
  ownerItem   ItemMaster?      @relation("BomContributionOwner", fields: [ownerItemId], references: [id], onDelete: Cascade)

  /// The component it brings: either a fixed item...
  componentItemId String?
  componentItem   ItemMaster? @relation("BomContributionComponent", fields: [componentItemId], references: [id], onDelete: Restrict)
  /// ...or whatever was answered in this field — the "[fabric slot]".
  sourceFieldId   String?
  sourceField     SpecField?  @relation("BomContributionSource", fields: [sourceFieldId], references: [id], onDelete: Cascade)

  quantity     Float   @default(1)
  quantityFrom String?
  wastePercent Float   @default(0)
  sortOrder    Int     @default(0)

  quantityFromFieldId String?
  quantityFromField   SpecField? @relation("BomContributionQuantityFrom", fields: [quantityFromFieldId], references: [id], onDelete: SetNull)

  @@index([factoryId])
  @@index([optionId])
  @@index([refId])
  @@index([ownerItemId])
}

/// One item's departure from what its category and contributions produce.
///
/// Separate from BomTemplateLine because an override can *remove* an inherited
/// line, and "a template line that means delete something" would be a trap on a
/// table whose other rows mean the opposite.
model ItemBomOverride {
  id        String @id @default(cuid())
  factoryId String

  itemId String
  item   ItemMaster @relation("ItemBomOverrideOwner", fields: [itemId], references: [id], onDelete: Cascade)

  componentItemId String
  componentItem   ItemMaster @relation("ItemBomOverrideComponent", fields: [componentItemId], references: [id], onDelete: Restrict)

  /// Drop this component for this item, whatever the recipe says.
  removed Boolean @default(false)

  quantity     Float @default(1)
  wastePercent Float @default(0)
  sortOrder    Int   @default(0)

  @@unique([itemId, componentItemId])
  @@index([factoryId])
}

// Owner-defined custom field that applies to every item. Values are stored in
// ItemMaster.customFields keyed by this id.
model ItemFieldDefinition {
  id        String   @id @default(cuid())
  factoryId String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([factoryId])
}

model MaterialCategory {
  id            String                @id @default(cuid())
  factoryId     String
  name          String
  materials     ItemMaster[]
  subcategories MaterialSubcategory[]

  @@unique([factoryId, name])
}

model MaterialSubcategory {
  id         String           @id @default(cuid())
  factoryId  String
  categoryId String
  category   MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  items      ItemMaster[]

  @@unique([factoryId, categoryId, name])
  @@index([factoryId])
}

model UOMConversion {
  id               String     @id @default(cuid())
  itemId           String
  item             ItemMaster @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromUOM          String
  toUOM            String
  conversionFactor Float
}

model Warehouse {
  id           String   @id @default(cuid())
  factoryId    String
  name         String
  kind         String   @default("WAREHOUSE") // WAREHOUSE | STORE
  customFields Json?    @default("{}")
  createdAt    DateTime @default(now())

  zones      WarehouseZone[]
  dispatches Dispatch[]

  @@unique([factoryId, name])
}

model WarehouseZone {
  id          String          @id @default(cuid())
  factoryId   String?
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  name        String
  racks       WarehouseRack[]
}

model WarehouseRack {
  id        String           @id @default(cuid())
  factoryId String?
  zoneId    String
  zone      WarehouseZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name      String
  shelves   WarehouseShelf[]
}

model WarehouseShelf {
  id        String         @id @default(cuid())
  factoryId String?
  rackId    String
  rack      WarehouseRack  @relation(fields: [rackId], references: [id], onDelete: Cascade)
  name      String
  bins      WarehouseBin[]
}

model WarehouseBin {
  id        String         @id @default(cuid())
  factoryId String?
  shelfId   String
  shelf     WarehouseShelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  name      String

  balances           BinBalance[]
  stockLedgerEntries StockLedgerEntry[]
}

model StockLedgerEntry {
  id               String       @id @default(cuid())
  factoryId        String
  transactionType  String // RECEIPT, ISSUE, TRANSFER, ADJUSTMENT
  itemId           String
  item             ItemMaster   @relation(fields: [itemId], references: [id])
  binId            String
  bin              WarehouseBin @relation(fields: [binId], references: [id])
  quantityChange   Float
  valuationRate    Float // Cost per unit at time of transaction
  totalValue       Float // quantityChange * valuationRate
  batchNumber      String?
  referenceDocType String? // e.g. "PurchaseReceipt", "ProductionReceipt"
  referenceDocId   String?
  adjustmentType   String? // manual adjustments: WASTAGE, DAMAGED, LOST, EXTRA_CONSUMED, CORRECTION, RECONCILIATION
  notes            String? // mandatory remark on manual adjustments
  createdById      String? // who performed a manual adjustment
  stockStatus      String? // QC moves: AVAILABLE, QC_HOLD, REJECTED
  supplierId       String? // batch provenance, captured on goods receipt
  manufacturedAt   DateTime? // batch manufacture date, captured on goods receipt
  createdAt        DateTime     @default(now())

  @@index([factoryId])
  @@index([itemId])
  @@index([binId])
}

model BinBalance {
  id             String       @id @default(cuid())
  factoryId      String
  itemId         String
  item           ItemMaster   @relation(fields: [itemId], references: [id])
  binId          String
  bin            WarehouseBin @relation(fields: [binId], references: [id])
  stockAvailable Float        @default(0)
  // Quarantine buckets. Stock that failed or is awaiting incoming QC is still
  // physically present but must not be issuable, so it is held apart from
  // stockAvailable rather than just flagged.
  stockQcHold    Float        @default(0)
  stockRejected  Float        @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([itemId, binId])
}

model MaterialReservation {
  id               String     @id @default(cuid())
  factoryId        String
  itemId           String
  item             ItemMaster @relation("ReservedMaterial", fields: [itemId], references: [id])
  quantity         Float
  productionPlanId String?
  workOrderId      String?
  workOrder        WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  status           String     @default("ACTIVE") // ACTIVE, CONSUMED, CANCELLED
  createdAt        DateTime   @default(now())

  @@index([factoryId])
  @@index([workOrderId])
}

model Dispatch {
  id                     String     @id @default(cuid())
  factoryId              String
  salesOrderId           String
  salesOrder             SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  destinationType        String // WAREHOUSE | STORE | CUSTOMER
  destinationWarehouseId String?
  destinationWarehouse   Warehouse? @relation(fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  customerName           String?
  customerPhone          String?
  address                String?
  transporter            String?
  vehicleNo              String?
  trackingId             String?
  notes                  String?
  status                 String     @default("IN_TRANSIT") // IN_TRANSIT | DELIVERED
  dispatchedAt           DateTime   @default(now())
  deliveredAt            DateTime?

  @@index([factoryId])
  @@index([salesOrderId])
}

// ==========================================
// CATALOG ENGINE
// ==========================================

// Retired: ProductCategory / Product / ProductVariant. Production keys on the
// finished-good ItemMaster and its ItemGroup now.

// ==========================================
// BLUEPRINT ENGINE (The DNA)
// ==========================================

model Blueprint {
  id              String     @id @default(cuid())
  factoryId       String
  // The blueprint now hangs off the item: production is planned against what is
  // made, and what is made is an item.
  itemId          String     @unique
  item            ItemMaster @relation(fields: [itemId], references: [id], onDelete: Cascade)
  activeVersionId String? // Points to BlueprintVersion.id

  versions BlueprintVersion[]
}

model BlueprintVersion {
  id                String             @id @default(cuid())
  blueprintId       String
  blueprint         Blueprint          @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  versionNumber     Int
  name              String // e.g. "V1 - Standard Routing"
  estimatedTimeMins Float              @default(0)
  qcTemplateId      String?
  qcTemplate        ChecklistTemplate? @relation(fields: [qcTemplateId], references: [id])
  isActive          Boolean            @default(false)
  createdAt         DateTime           @default(now())

  bom             BOM?
  routeSteps      BlueprintRouteStep[]
  documents       FactoryDocument[]
  productionPlans ProductionPlan[]
  salesOrderItems SalesOrderItem[]

  @@unique([blueprintId, versionNumber])
}

model BlueprintRouteStep {
  id                 String           @id @default(cuid())
  blueprintVersionId String
  blueprintVersion   BlueprintVersion @relation(fields: [blueprintVersionId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department       @relation(fields: [departmentId], references: [id])
  sequence           Int
  estimatedTimeMins  Float            @default(0)
  requiredSkills     String[]
  instructions       String?          @db.Text
}

model FactoryDocument {
  id                 String           @id @default(cuid())
  blueprintVersionId String
  blueprintVersion   BlueprintVersion @relation(fields: [blueprintVersionId], references: [id], onDelete: Cascade)
  title              String
  fileUrl            String
  documentType       String // DRAWING, VIDEO, GUIDE
  createdAt          DateTime         @default(now())
}

// ==========================================
// VEHICLE FITMENT ENGINE
// ==========================================

// ==========================================
// PROCUREMENT ENGINE
// ==========================================

model Supplier {
  id            String   @id @default(cuid())
  factoryId     String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gst           String?
  pan           String?
  bankName      String?
  bankAccount   String?
  paymentTerms  String?
  leadTimeDays  Int?
  customFields  Json?    @default("{}")
  createdAt     DateTime @default(now())

  purchaseOrders PurchaseOrder[]
}

model PurchaseRequest {
  id             String    @id @default(cuid())
  factoryId      String
  prNumber       String    @unique
  status         String // DRAFT, PENDING_APPROVAL, APPROVED, ORDERED
  requestedById  String
  requiredByDate DateTime?
  createdAt      DateTime  @default(now())
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  factoryId    String
  poNumber     String    @unique
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  status       String // DRAFT, SUBMITTED, PARTIALLY_RECEIVED, COMPLETED, CANCELLED
  orderDate    DateTime  @default(now())
  expectedDate DateTime?

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialId      String
  material        ItemMaster    @relation(fields: [materialId], references: [id])
  quantity        Float
  rate            Float         @default(0)
  receivedQty     Float         @default(0) // cumulative qty received across GRNs
}

model PurchaseReceipt {
  id              String   @id @default(cuid())
  factoryId       String
  receiptNumber   String   @unique
  purchaseOrderId String
  supplierId      String
  status          String // DRAFT, SUBMITTED
  receiptDate     DateTime @default(now())
  receivedById    String?

  items PurchaseReceiptItem[]
}

model PurchaseReceiptItem {
  id          String          @id @default(cuid())
  receiptId   String
  receipt     PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  materialId  String
  quantity    Float
  rate        Float           @default(0)
  batchNumber String?
}

model PurchaseInvoice {
  id            String   @id @default(cuid())
  factoryId     String
  invoiceNumber String   @unique
  supplierId    String
  totalAmount   Float
  status        String // UNPAID, PAID
  dueDate       DateTime
}

// ==========================================
// MANUFACTURING ENGINE
// ==========================================

model BOM {
  id                 String           @id @default(cuid())
  factoryId          String
  blueprintVersionId String           @unique
  blueprintVersion   BlueprintVersion @relation(fields: [blueprintVersionId], references: [id], onDelete: Cascade)
  items              BOMItem[]
}

model BOMItem {
  id           String     @id @default(cuid())
  bomId        String
  bom          BOM        @relation(fields: [bomId], references: [id], onDelete: Cascade)
  itemId       String
  item         ItemMaster @relation("MaterialUsed", fields: [itemId], references: [id])
  quantity     Float
  wastePercent Float      @default(0)
}

model ProductionPlan {
  id                 String           @id @default(cuid())
  factoryId          String
  salesOrderId       String?
  salesOrder         SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  blueprintVersionId String
  blueprintVersion   BlueprintVersion @relation(fields: [blueprintVersionId], references: [id])
  quantity           Float
  priority           String           @default("NORMAL") // URGENT, NORMAL, LOW
  status             String           @default("PENDING") // PENDING, RELEASED, CANCELLED
  targetStartDate    DateTime?
  createdAt          DateTime         @default(now())

  workOrders WorkOrder[]
}

model WorkOrder {
  id               String         @id @default(cuid())
  factoryId        String
  woNumber         String         @unique
  productionPlanId String
  productionPlan   ProductionPlan @relation(fields: [productionPlanId], references: [id])
  status           String         @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED
  targetQty        Float
  producedQty      Float          @default(0)
  startDate        DateTime?
  endDate          DateTime?

  jobCards     JobCard[]
  reservations MaterialReservation[]
}

model JobCard {
  id            String         @id @default(cuid())
  factoryId     String
  workOrderId   String
  workOrder     WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department     @relation(fields: [departmentId], references: [id])
  sequence      Int
  status        String         @default("WAITING") // WAITING, IN_PROGRESS, ON_HOLD, BLOCKED, QC_PENDING, REWORK_REQUIRED, COMPLETED
  stageId       String? // Workflow stage this card executes (null on legacy single-card orders)
  stage         WorkflowStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  reworkReason  String? // Pinned QC rejection reason while status is REWORK_REQUIRED
  assignedToId  String?
  assignedTo    User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  targetQty     Float
  completedQty  Float          @default(0)
  timeSpentMins Float          @default(0)
  startedAt     DateTime?
  completedAt   DateTime?

  inspection   Inspection?
  stageEntries StageEntry[]

  // The QC/checklist template this card ran, pinned at creation so the order
  // review shows exactly which template each department used (product-based:
  // mats and seat covers resolve to different templates). Null on legacy cards.
  templateId String?
  template   ChecklistTemplate? @relation("JobCardTemplate", fields: [templateId], references: [id], onDelete: SetNull)

  @@index([factoryId])
  @@index([workOrderId])
}

// A stage submission: what the operator captured when working a stage card.
// One row per submission attempt, so rework history is preserved.
model StageEntry {
  id               String   @id @default(cuid())
  factoryId        String
  jobCardId        String
  jobCard          JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  submittedById    String?
  beforeImages     Json? // array of public URLs
  afterImages      Json? // array of public URLs
  measurements     String?
  materialNotes    String?
  remarks          String?
  // Department stage-checklist results when the stage carries a template:
  // [{ checkpointId, name, ok, value, remarks, images: [publicUrl] }]
  checklist        Json?
  // Walkthrough video for stages whose template asks for one (e.g. Packing).
  // QC records its clip on the Inspection; a department stage has none, so the
  // clip lives here.
  videoUrl         String?
  videoPath        String?
  videoDurationSec Int?
  outcome          String   @default("SUBMITTED") // SUBMITTED, APPROVED, REWORK
  createdAt        DateTime @default(now())

  @@index([jobCardId])
  @@index([factoryId])
}

// ==========================================
// CRM & SALES ENGINE
// ==========================================

model Customer {
  id                  String       @id @default(cuid())
  factoryId           String
  customerCode        String?
  name                String
  companyName         String?
  phone               String?
  altPhone            String?
  email               String?
  gstNumber           String?
  billingAddress      String?
  shippingAddress     String?
  notes               String?
  // Retail / Dealer / OEM / Internal (and any free tags). Dealers are simply a
  // tagged customer, not a separate entity.
  tags                String[]     @default([])
  assignedSalesperson String?
  creditLimit         Float        @default(0)
  paymentTerms        String?
  customFields        Json?        @default("{}")
  createdAt           DateTime     @default(now())
  salesOrders         SalesOrder[]

  // Service-side counterparty links. A customer owns sites; work, tickets,
  // projects and invoices all hang off the customer directly as well, because
  // not every service engagement has a physical site.
  sites             Site[]
  tickets           Ticket[]
  serviceWorkOrders ServiceWorkOrder[]
  projects          Project[]
  serviceInvoices   ServiceInvoice[]

  @@unique([factoryId, customerCode])
}

model Deal {
  id            String    @id @default(cuid())
  factoryId     String
  title         String
  customerId    String?
  amount        Float
  stage         String // PROSPECTING, QUALIFIED, PROPOSAL, WON, LOST
  probability   Int       @default(50)
  expectedClose DateTime?
  ownerId       String
}

enum OrderType {
  RETAIL
  DEALER
  OEM
  INTERNAL
}

model SalesOrder {
  id                   String    @id @default(cuid())
  factoryId            String
  soNumber             String    @unique
  customerId           String
  status               String // DRAFT, APPROVED, IN_PRODUCTION, READY, DISPATCHED
  // Who booked the order — used to scope a store manager to their own orders.
  createdById          String?
  // Retail / Dealer / OEM / Internal. A "dealer order" is just an order whose
  // type is DEALER — there is no separate dealer entity or portal.
  orderType            OrderType @default(RETAIL)
  // Identity of the physical production bag: printed once before manufacturing
  // and carried CAD -> Cutting -> Stitching -> QC -> Packing -> Dispatch.
  labelCode            String?   @unique
  totalAmount          Float     @default(0)
  expectedDeliveryDate DateTime?
  orderDate            DateTime  @default(now())

  // THE source of truth for what this order makes. Production, BOM, QC and
  // routing all resolve from here. Set for every order — createOrder derives it
  // from the spec via resolveOrderItem when the studio does not supply one.
  itemId String?
  // Restrict, not SetNull: an order silently losing the item it was placed
  // for is worse than a refused delete, and every other reference (BOM, stock)
  // already refuses.
  item   ItemMaster? @relation("OrderItem", fields: [itemId], references: [id], onDelete: Restrict)

  // Denormalised copies of the item's spec, kept because dashboard, floor,
  // reports, labels and CAD read them directly for display. They are written
  // from the same answers that resolve `itemId`, so they cannot disagree with
  // it — but they are a display cache, NOT a second source of truth. Never
  // branch production logic on these; read `item` instead.
  materialId            String?
  material              ItemMaster?      @relation("OrderMaterial", fields: [materialId], references: [id], onDelete: SetNull)
  designId              String?
  design                ItemMaster?      @relation("OrderDesign", fields: [designId], references: [id], onDelete: SetNull)
  // Colours are ordinary items in an ordinary category now, so the order points
  // at ItemMaster like it does for material. The column name stays `colorId` —
  // renaming it would touch every caller for no gain.
  colorId               String?
  color                 ItemMaster?      @relation("OrderColour", fields: [colorId], references: [id], onDelete: SetNull)
  // Legacy ProductType id, kept as a bare column; the ProductType table is gone.
  productTypeId         String?
  inspectorId           String?
  inspector             User?            @relation("OrderInspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  fulfilledFromOrderId  String? // stock-matched: the production whose goods and passport this order uses
  // Scheduled release: workers don't see the job until this date arrives, then
  // it's their task for the day. Null means "on the floor now".
  scheduledFor          DateTime?
  fulfilledFromStockQty Float?           @default(0) // partial stock: how many of the order were taken from stock
  productionBatchId     String? // set when drafts are released together as one batch
  productionBatch       ProductionBatch? @relation(fields: [productionBatchId], references: [id], onDelete: SetNull)
  /// The outlet or store this order belongs to, for franchise networks.
  ///
  /// Null for a single-location business, which is why it is nullable rather
  /// than required — a factory has no outlets and should not be made to invent
  /// one. Where it is set, it is what makes per-outlet reporting and the daily
  /// SOP gate possible: without it there is no way to ask "has *this* outlet
  /// opened properly today".
  siteId String?
  site   Site?   @relation("SalesOrderSite", fields: [siteId], references: [id], onDelete: SetNull)

  // Vehicle is stored per-order. Previously it lived only as a fitment on the
  // (shared) product variant, so two orders of the same product type showed
  // each other's vehicle. These columns give every order its own identity.
  vehicleBrandId        String?
  vehicleBrand          ItemMaster?      @relation("OrderVehicleBrand", fields: [vehicleBrandId], references: [id], onDelete: SetNull)
  vehicleModelId        String?
  vehicleModel          ItemMaster?      @relation("OrderVehicleModel", fields: [vehicleModelId], references: [id], onDelete: SetNull)
  vehicleYear           String?
  seatType              String?
  hasArmrest            Boolean          @default(false)
  headrestCount         Int?
  remarks               String?
  photoReference        String?
  dynamicData           Json?

  customer    Customer         @relation(fields: [customerId], references: [id])
  items       SalesOrderItem[]
  plans       ProductionPlan[]
  dispatches  Dispatch[]
  productType ProductType?     @relation(fields: [productTypeId], references: [id])
}

enum FieldType {
  TEXT
  SELECT
  NUMBER
  MEASUREMENT
  TOGGLE
  BUTTONS
  CHECKBOX
  /// All of these store a plain string in ItemFieldValue.valueText — there is
  /// no `value` column. What differs is the input and how the cell renders:
  /// IMAGE and FILE hold a URL, DATE an ISO date, COLOR a #RRGGBB, TEXTAREA
  /// multi-line prose.
  IMAGE
  FILE
  DATE
  COLOR
  TEXTAREA
}

// A validated Carxen product configuration: the vehicle + product + spec
// identity that a production is built on. Fabric/Design/Colour are selected
// per-production (the variable part) and are intentionally NOT stored here —
// this table is the reusable "up-to-specs" template that drives the studio's
// progressive auto-selection and batch auto-population.
// Retired: ProductCombination (the studio's variant search replaced it) and
// ProductType / ProductField (spec columns live on ItemGroup now).

// Groups draft productions released to the floor together (e.g. several
// identical Brezza orders accumulated in Draft, clubbed into one run).
model ProductionBatch {
  id          String   @id @default(cuid())
  factoryId   String
  batchNumber String   @unique
  createdAt   DateTime @default(now())

  salesOrders SalesOrder[]

  @@index([factoryId])
}

model SalesOrderItem {
  id                 String            @id @default(cuid())
  salesOrderId       String
  salesOrder         SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  // The finished good this line produces — the source of truth now that
  // Product / ProductVariant are being retired.
  itemId             String?
  item               ItemMaster?       @relation("SalesOrderLineItem", fields: [itemId], references: [id], onDelete: Restrict)
  // Legacy sales-variant id, kept as a bare column; the ProductVariant table is
  // gone. Order lines resolve through itemId.
  productVariantId   String?
  quantity           Float
  blueprintVersionId String?
  blueprintVersion   BlueprintVersion? @relation(fields: [blueprintVersionId], references: [id])
  unitPrice          Float
}

// ==========================================
// WORKFORCE ENGINE
// ==========================================

model EmployeeProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  factoryId      String
  dateOfJoining  DateTime
  employmentType String // PERMANENT, CONTRACT, DAILY
  hourlyRate     Float?
  skills         String[]
  defaultShiftId String?
}

model Shift {
  id              String @id @default(cuid())
  factoryId       String
  name            String
  startTime       String // e.g. "08:00"
  endTime         String // e.g. "16:00"
  gracePeriodMins Int    @default(15)

  // A Shift is a definition, not a calendar entry. Deployments post a person to
  // a site on a shift indefinitely; schedules pin one person to one date.
  deployments SiteDeployment[]
  schedules   ShiftSchedule[]
}

model AttendanceLog {
  id            String    @id @default(cuid())
  factoryId     String
  userId        String
  shiftId       String?
  clockIn       DateTime
  clockOut      DateTime?
  isLate        Boolean   @default(false)
  overtimeHours Float     @default(0)
  status        String // PRESENT, HALF_DAY, ABSENT
}

model LeaveApplication {
  id           String   @id @default(cuid())
  factoryId    String
  userId       String
  leaveType    String // CASUAL, SICK, UNPAID
  fromDate     DateTime
  toDate       DateTime
  status       String // PENDING, APPROVED, REJECTED
  approvedById String?
}

// ==========================================
// QUALITY ENGINE (FROZEN/PRESERVED)
// ==========================================

/// A checklist a department runs against a job: Cutting's pre-cut checks,
/// Packing's dispatch checks, QC's inspection. It was called QCTemplate, which
/// taught everyone it was a QC feature — the model has always been generic
/// (Department.templateId points here, and nothing on Checkpoint is about
/// quality), but nobody ever attached one to Cutting because of the name.
///
/// `@@map` keeps the table exactly where it is: this is a rename of the
/// concept, not a migration of the data.
model ChecklistTemplate {
  id               String   @id @default(cuid())
  factoryId        String
  name             String
  version          String   @default("1.0")
  isLatest         Boolean  @default(true)
  parentTemplateId String?
  status           String   @default("active")
  // When true the worker must attach a walkthrough video before submitting the
  // inspection, and the supervisor must review it before sign-off.
  requiresVideo    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentTemplate    ChecklistTemplate?  @relation("TemplateVersions", fields: [parentTemplateId], references: [id], onDelete: SetNull)
  childTemplates    ChecklistTemplate[] @relation("TemplateVersions")
  /// The one department this checklist belongs to (Cutting, Packing, QC...).
  /// A template is dedicated to a single stage; which products it covers is the
  /// separate, many-valued question answered by defaultForItemGroups.
  ownerDepartmentId String?
  ownerDepartment   Department?         @relation("DepartmentTemplates", fields: [ownerDepartmentId], references: [id], onDelete: SetNull)

  sections             TemplateSection[]
  jobCards             JobCard[]         @relation("JobCardTemplate")
  defaultForItemGroups ItemGroup[]       @relation("ItemGroupDefaultChecklist")

  /// Service work orders that run this checklist on completion. A checklist is
  /// stage-shaped, so it serves a site visit as readily as a production stage.
  serviceWorkOrders  ServiceWorkOrder[]  @relation("ServiceWOChecklist")
  serviceInspections ServiceInspection[] @relation("ServiceInspectionChecklist")

  blueprintVersions BlueprintVersion[]

  @@index([factoryId])
  @@index([parentTemplateId])
  @@map("QCTemplate")
}

model TemplateSection {
  id            String            @id @default(cuid())
  factoryId     String
  templateId    String
  template      ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title         String
  titleHi       String?
  titleHinglish String?
  sortOrder     Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  checkpoints Checkpoint[]

  @@index([factoryId])
  @@index([templateId])
}

model Checkpoint {
  id                   String          @id @default(cuid())
  factoryId            String
  sectionId            String
  section              TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name                 String
  nameHi               String?
  nameHinglish         String?
  instructions         String
  instructionsHi       String?
  instructionsHinglish String?
  // Photos are opt-in: a checkpoint only demands one when the template author
  // explicitly asks for it. Defaulting to true silently blocked submissions on
  // checkpoints nobody had configured.
  requireImage         Boolean         @default(false)
  requireRemarks       Boolean         @default(false)
  // Whether the worker must answer this checkpoint. Optional ones can be left
  // blank without blocking submission.
  isRequired           Boolean         @default(true)
  /// How the worker answers: PASS_FAIL (default), TEXT, NUMBER, MEASUREMENT.
  /// This is what makes "Measurements" / "Material used" ordinary checkpoints an
  /// owner can add, rename or drop, instead of fields hardcoded into the form.
  inputType            String          @default("PASS_FAIL")
  /// Acceptable range for a MEASUREMENT answer. Either bound may stand alone —
  /// a minimum temperature with no ceiling is an ordinary food-safety rule.
  /// Null on both means the checkpoint is not ranged and nothing is enforced.
  minValue             Float?
  maxValue             Float?

  /// Shown under the input as a hint, e.g. "e.g. Back panel 58 x 64 cm".
  placeholder          String?
  // A reference photo of the correct result, shown to the worker while they
  // answer so they can compare their work against it.
  referenceImageUrl    String?
  sortOrder            Int
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  submissions        CheckpointSubmission[]
  serviceSubmissions ServiceCheckpointSubmission[]

  @@index([factoryId])
  @@index([sectionId])
}

model Inspection {
  id          String    @id @default(cuid())
  factoryId   String
  jobCardId   String    @unique
  jobCard     JobCard   @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  status      QCStatus  @default(IN_PROGRESS)
  startedAt   DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // A short walkthrough video of the finished piece (30–60s), captured during
  // QC. Photos prove individual checkpoints; the video proves the whole item
  // and is the strongest evidence in a customer dispute.
  videoUrl          String?
  videoPath         String?
  videoDurationSec  Float?
  videoUploadedAt   DateTime?
  videoUploadedById String?

  submissions   CheckpointSubmission[]
  approval      QualityApproval?
  report        QualityReport?
  reworkRecords ReworkRecord[]

  @@index([factoryId])
  @@index([factoryId, status])
}

model CheckpointSubmission {
  id                 String     @id @default(cuid())
  factoryId          String
  inspectionId       String
  inspection         Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checkpointId       String
  checkpoint         Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  passFail           String?
  /// What was done about an out-of-range reading. Required when a ranged
  /// checkpoint breaches, because a recorded breach with no action is an audit
  /// finding rather than a record of one being handled.
  correctiveAction   String?
  /// The typed answer for non pass/fail checkpoints (text, number, measurement).
  value              String?
  remarks            String?
  completedAt        DateTime?
  verificationStatus String?
  inspectorComment   String?
  verifiedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  evidences ImageEvidence[]

  @@index([factoryId])
  @@index([inspectionId])
}

model ImageEvidence {
  id           String               @id @default(cuid())
  factoryId    String
  submissionId String
  submission   CheckpointSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  storageKey   String
  publicUrl    String
  mimeType     String
  uploadedById String? // who captured this evidence photo
  createdAt    DateTime             @default(now())
}

model QualityApproval {
  id           String     @id @default(cuid())
  factoryId    String
  inspectionId String     @unique
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectorId  String
  status       String
  comments     String?
  createdAt    DateTime   @default(now())
}

model QualityReport {
  id               String     @id @default(cuid())
  factoryId        String
  inspectionId     String     @unique
  inspection       Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  verificationCode String     @unique
  pdfUrl           String?
  generatedAt      DateTime   @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([factoryId])
  @@index([verificationCode])
}

model ReworkRecord {
  id           String     @id @default(cuid())
  factoryId    String
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  defectCode   String
  workerId     String
  comments     String?    @db.Text
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())
}

// ==========================================
// DISPATCH ENGINE
// ==========================================

model ProductType {
  id             String        @id @default(cuid())
  factoryId      String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  key            String?
  labelTemplate  String?
  isPhysical     Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  fields      ProductField[]
  salesOrders SalesOrder[]

  @@index([factoryId])
  @@index([organizationId])
}

model ProductField {
  id            String    @id @default(cuid())
  productTypeId String
  name          String
  key           String?
  type          FieldType
  options       Json?
  isRequired    Boolean   @default(false)
  sortOrder     Int       @default(0)

  optionSource   String?
  parentFieldId  String?
  parentField    ProductField?  @relation("FieldHierarchy", fields: [parentFieldId], references: [id], onDelete: SetNull)
  children       ProductField[] @relation("FieldHierarchy")
  visibleWhen    Json?
  validation     Json?
  showOnJobCard  Boolean        @default(false)
  showOnPassport Boolean        @default(false)
  unit           String?
  helpText       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productType ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@unique([productTypeId, key])
  @@index([productTypeId])
  @@index([parentFieldId])
}

model Organization {
  id                   String  @id @default(cuid())
  name                 String
  slug                 String  @unique
  logoUrl              String?
  currency             String  @default("INR")
  timezone             String  @default("Asia/Kolkata")
  fiscalYearStartMonth Int     @default(4)

  settings  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factories    Factory[]
  roles        Role[]
  entitlements ModuleEntitlement[]
  productTypes ProductType[]
  subscription TenantSubscription?
}

model ModuleEntitlement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moduleKey      String
  enabled        Boolean      @default(true)
  expiresAt      DateTime?
  settings       Json?        @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, moduleKey])
  @@index([organizationId])
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  systemRole     SystemRole
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  permissions    RolePermission[]
  users          User[]
  workflowStages WorkflowStage[]
  approvals      Approval[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RolePermission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  key    String

  @@unique([roleId, key])
  @@index([roleId])
}

enum SystemRole {
  OWNER
  CO_OWNER
  MANAGER
  SUPERVISOR
  WORKER
  STORE_MANAGER
}

// ==========================================
// SERVICE OPERATIONS
//
// The production side of Verity models Customer -> Order -> WorkOrder -> JobCard.
// Service businesses run the same skeleton with different nouns: Client -> Site
// -> Deployment -> Ticket/ServiceWorkOrder -> Invoice. These models are that
// second spine. They deliberately do not reuse `WorkOrder`, which requires a
// ProductionPlan and a produced item — neither of which a site visit has.
//
// Tenancy convention here matches the rest of the file: `factoryId` is a bare
// scalar with an index, not a relation, so Factory stays free of back-links.
// ==========================================

enum SiteStatus {
  ACTIVE
  ON_HOLD
  TERMINATED
}

enum ServiceWOStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING_PARTS
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  IDLE
  RETIRED
  DISPOSED
}

enum ScheduleStatus {
  SCHEDULED
  ATTENDED
  ABSENT
  SWAPPED
  CANCELLED
}

enum SwapStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  FINALISED
  EXPORTED
}

// --- Sites ----------------------------------------------------------------

/// A physical location belonging to a client where work happens: the guarded
/// premises, the serviced building, the construction site. Distinct from
/// Warehouse, which locates stock rather than work.
model Site {
  id        String @id @default(cuid())
  factoryId String

  name     String
  siteCode String
  address  String?
  city     String?
  state    String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  status SiteStatus @default(ACTIVE)

  managerUserId String?
  managerUser   User?   @relation("SiteManager", fields: [managerUserId], references: [id], onDelete: SetNull)

  contractStart DateTime?
  contractEnd   DateTime?
  /// SLA response window in hours, used to stamp `slaDueAt` on work raised here.
  slaHours      Int?
  notes         String?

  deployments SiteDeployment[]
  workOrders  ServiceWorkOrder[]
  tickets     Ticket[]
  projects    Project[]
  assets      Asset[]
  schedules   ShiftSchedule[]
  invoices    ServiceInvoice[]
  inspections ServiceInspection[]
  /// Orders booked at this outlet, for franchise networks.
  salesOrders SalesOrder[]        @relation("SalesOrderSite")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factoryId, siteCode])
  @@index([factoryId])
  @@index([factoryId, status])
  @@index([customerId])
}

/// A posting of one person to one site. `endDate` null means still deployed.
model SiteDeployment {
  id        String @id @default(cuid())
  factoryId String

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("SiteDeploymentUser", fields: [userId], references: [id], onDelete: Cascade)

  /// Free text rather than an enum: "Guard", "Housekeeper", "Technician" are
  /// tenant vocabulary, and constraining them would fork the model per vertical.
  role      String?
  startDate DateTime
  endDate   DateTime?

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([factoryId])
  @@index([siteId, isActive])
  @@index([userId])
}

// --- Helpdesk -------------------------------------------------------------

model Ticket {
  id           String @id @default(cuid())
  factoryId    String
  ticketNumber String

  subject     String
  description String?
  category    String?

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  reportedById String?
  reportedBy   User?   @relation("TicketReporter", fields: [reportedById], references: [id], onDelete: SetNull)

  /// Stamped from the site's `slaHours` at creation. Breach is derived, never
  /// stored, so changing the SLA never rewrites history.
  slaDueAt   DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?

  comments   TicketComment[]
  workOrders ServiceWorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factoryId, ticketNumber])
  @@index([factoryId])
  @@index([factoryId, status])
  @@index([siteId])
  @@index([assignedToId])
}

model TicketComment {
  id        String @id @default(cuid())
  factoryId String

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  body       String
  /// Internal notes are invisible to the customer-facing view of the thread.
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([factoryId])
  @@index([ticketId])
}

/// The service-sector counterpart to a production WorkOrder: dispatchable work
/// at a site, optionally born from a ticket, optionally gated by a checklist.
model ServiceWorkOrder {
  id        String @id @default(cuid())
  factoryId String

  woNumber    String
  title       String
  description String?
  /// "Corrective", "Preventive", "Inspection", "Installation".
  category    String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("ServiceWOAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  status   ServiceWOStatus @default(OPEN)
  priority TicketPriority  @default(MEDIUM)

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  slaDueAt    DateTime?

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  checklistId String?
  checklist   ChecklistTemplate? @relation("ServiceWOChecklist", fields: [checklistId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  /// Raised when the visit is completed and a checklist was attached.
  inspection ServiceInspection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factoryId, woNumber])
  @@index([factoryId])
  @@index([factoryId, status])
  @@index([siteId])
  @@index([assignedToId])
}

// --- Projects -------------------------------------------------------------

model Project {
  id            String @id @default(cuid())
  factoryId     String
  projectNumber String

  name        String
  description String?
  status      ProjectStatus @default(PLANNING)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  startDate DateTime?
  endDate   DateTime?

  budget       Float @default(0)
  /// Rate used to price timesheet hours when nothing more specific applies.
  billableRate Float @default(0)

  tasks      Task[]
  timesheets TimesheetEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factoryId, projectNumber])
  @@index([factoryId])
  @@index([factoryId, status])
  @@index([customerId])
}

model Task {
  id        String @id @default(cuid())
  factoryId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      TaskStatus     @default(TODO)
  priority    TicketPriority @default(MEDIUM)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueDate     DateTime?
  completedAt DateTime?

  estimatedHours Float @default(0)

  timesheets TimesheetEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factoryId])
  @@index([projectId, status])
  @@index([assigneeId])
}

model TimesheetEntry {
  id        String @id @default(cuid())
  factoryId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation("TimesheetUser", fields: [userId], references: [id], onDelete: Cascade)

  date  DateTime
  hours Float

  notes      String?
  billable   Boolean   @default(true)
  /// Approval gates both billing and payroll, so it is a flag plus a time
  /// rather than a status enum that could drift apart from those two consumers.
  approved   Boolean   @default(false)
  approvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([factoryId])
  @@index([projectId])
  @@index([userId, date])
}

// --- Assets ---------------------------------------------------------------

model Asset {
  id        String @id @default(cuid())
  factoryId String

  assetCode    String
  name         String
  category     String?
  /// Generator, HVAC unit, forklift: identity that survives a rename.
  serialNumber String?
  manufacturer String?
  model        String?

  status AssetStatus @default(ACTIVE)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("AssetAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  location String?

  purchaseDate  DateTime?
  purchaseCost  Float     @default(0)
  warrantyUntil DateTime?

  notes String?

  maintenanceLogs      AssetMaintenanceLog[]
  maintenanceSchedules AssetMaintenanceSchedule[]
  workOrders           ServiceWorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factoryId, assetCode])
  @@index([factoryId])
  @@index([factoryId, status])
  @@index([siteId])
}

model AssetMaintenanceLog {
  id        String @id @default(cuid())
  factoryId String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// "Preventive", "Corrective", "Inspection".
  type        String
  description String?

  performedById String?
  performedBy   User?   @relation("MaintenancePerformer", fields: [performedById], references: [id], onDelete: SetNull)

  performedAt   DateTime @default(now())
  cost          Float    @default(0)
  downtimeHours Float    @default(0)

  createdAt DateTime @default(now())

  @@index([factoryId])
  @@index([assetId, performedAt])
}

model AssetMaintenanceSchedule {
  id        String @id @default(cuid())
  factoryId String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  name            String
  /// Interval in days. Simple by design: cron-shaped recurrence is a whole
  /// scheduling engine, and every plan seen so far is "every N days".
  intervalDays    Int
  lastPerformedAt DateTime?
  nextDueAt       DateTime
  isActive        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factoryId])
  @@index([assetId])
  @@index([factoryId, nextDueAt])
}

// --- Scheduling -----------------------------------------------------------

/// One person, one shift, one date, optionally one site. This is the calendar
/// the `Shift` definition never was.
model ShiftSchedule {
  id        String @id @default(cuid())
  factoryId String

  userId String
  user   User   @relation("ShiftScheduleUser", fields: [userId], references: [id], onDelete: Cascade)

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  /// Midnight UTC of the calendar day. Time of day lives on the Shift.
  date   DateTime
  status ScheduleStatus @default(SCHEDULED)

  notes String?

  swaps ShiftSwap[]

  createdAt DateTime @default(now())

  @@unique([userId, date, shiftId])
  @@index([factoryId])
  @@index([factoryId, date])
  @@index([siteId, date])
}

model ShiftSwap {
  id        String @id @default(cuid())
  factoryId String

  scheduleId String
  schedule   ShiftSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("SwapRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  swapWithId String?
  swapWith   User?   @relation("SwapRecipient", fields: [swapWithId], references: [id], onDelete: SetNull)

  reason     String?
  status     SwapStatus @default(PENDING)
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([factoryId])
  @@index([factoryId, status])
  @@index([scheduleId])
}

// --- Billing --------------------------------------------------------------

/// The bridge from operations to money. Not an accounting ledger — a
/// client-facing invoice built from work that actually happened.
model ServiceInvoice {
  id        String @id @default(cuid())
  factoryId String

  invoiceNumber String

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  status InvoiceStatus @default(DRAFT)

  issueDate DateTime  @default(now())
  dueDate   DateTime?

  lineItems InvoiceLineItem[]

  /// Denormalised totals, recomputed from the line items on every write so a
  /// list view never has to load the items to show a number.
  subtotal  Float @default(0)
  taxAmount Float @default(0)
  total     Float @default(0)

  notes  String?
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factoryId, invoiceNumber])
  @@index([factoryId])
  @@index([factoryId, status])
  @@index([customerId])
}

model InvoiceLineItem {
  id        String         @id @default(cuid())
  invoiceId String
  invoice   ServiceInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Float
  unitPrice   Float
  amount      Float
  taxRate     Float  @default(0)

  @@index([invoiceId])
}

/// A period summary per employee, assembled from attendance and timesheets and
/// handed to whatever payroll system the tenant already runs. Verity does not
/// calculate pay; it supplies the inputs.
model PayrollInput {
  id        String @id @default(cuid())
  factoryId String

  userId String
  user   User   @relation("PayrollInputUser", fields: [userId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  presentDays   Int   @default(0)
  absentDays    Int   @default(0)
  overtimeHours Float @default(0)
  leaveDays     Int   @default(0)

  /// From TimesheetEntry when the projects module is on; zero otherwise.
  totalHours Float         @default(0)
  status     PayrollStatus @default(DRAFT)

  exportedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())

  @@unique([userId, periodStart, periodEnd])
  @@index([factoryId])
  @@index([factoryId, periodStart])
}

// --- Service quality ------------------------------------------------------

/// A checklist run against a completed site visit.
///
/// Deliberately not `Inspection`. That model is anchored to a JobCard by a
/// required FK and cascades from it — a service visit has no job card, and
/// loosening that FK would have put a nullable relation through every
/// production QC query for the sake of a second, unrelated caller. Two small
/// models that each say what they mean beat one that means either.
///
/// The checkpoint definitions are shared: both sides run the same
/// `ChecklistTemplate` and the same `Checkpoint` rows. Only the answers live
/// apart.
model ServiceInspection {
  id        String @id @default(cuid())
  factoryId String

  serviceWorkOrderId String           @unique
  serviceWorkOrder   ServiceWorkOrder @relation(fields: [serviceWorkOrderId], references: [id], onDelete: Cascade)

  /// Denormalised from the work order at creation so a site's inspection
  /// history survives the work order being re-pointed.
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  checklistId String
  checklist   ChecklistTemplate @relation("ServiceInspectionChecklist", fields: [checklistId], references: [id], onDelete: Restrict)

  status QCStatus @default(IN_PROGRESS)

  inspectedById String?
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  approvedAt    DateTime?
  approvedById  String?

  notes String?

  submissions ServiceCheckpointSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factoryId])
  @@index([factoryId, status])
  @@index([siteId])
}

model ServiceCheckpointSubmission {
  id        String @id @default(cuid())
  factoryId String

  inspectionId String
  inspection   ServiceInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  passFail String?
  /// The typed answer for non pass/fail checkpoints, matching CheckpointSubmission.
  value    String?
  remarks  String?
  photoUrl String?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// One answer per checkpoint per inspection — re-answering updates, never
  /// appends a second opinion.
  @@unique([inspectionId, checkpointId])
  @@index([factoryId])
  @@index([inspectionId])
}

// ==========================================
// HEADLESS INTEGRATION LAYER
//
// Verity is the operations engine, not the storefront and not the ledger.
// Orders arrive from an external channel (Shopify, a dealer portal) and
// milestones leave as webhooks for whatever is doing the books. These five
// models are the boundary: who may call in, what already happened, where to
// call out, and what is still owed.
// ==========================================

/// A saved-but-unsubmitted order the studio can come back to.
///
/// The order studio holds a lot of state — vehicle, spec, dynamic fields — and
/// losing it to a closed tab is the difference between an order booked and an
/// order not booked. `payload` is deliberately opaque Json: this is a draft of a
/// form, not a domain object, and giving it columns would mean migrating it
/// every time the studio gains a field.
model OrderDraft {
  id        String @id @default(cuid())
  factoryId String

  /// What the person called it, so a list of drafts is navigable.
  label   String
  payload Json

  createdById String?
  createdBy   User?   @relation("OrderDraftAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factoryId])
  @@index([factoryId, createdById])
}

/// A credential an external system uses to POST orders in.
///
/// The `factoryId` on this row is the ONLY thing that decides which tenant an
/// inbound order lands in — never the request body. A payload that names a
/// factory is a payload asking to write into someone else's workspace.
///
/// `tokenHash` not `token`: a leaked database dump should not be a set of live
/// credentials. `signingSecret` is stored recoverably because HMAC verification
/// needs the original bytes; it is the second factor, not the first.
model ApiKey {
  id        String @id @default(cuid())
  factoryId String

  /// Human label — "Shopify storefront", "Dealer portal staging".
  name String

  /// The visible, non-secret half, so an operator can tell two keys apart and
  /// revoke the right one. Shown in full in the console; matches the token
  /// prefix the caller sends.
  prefix String @unique

  /// SHA-256 of the full token. The token itself is shown once, at creation.
  tokenHash String @unique

  /// Shared secret for the `X-Verity-Signature` HMAC over the raw body. Stops a
  /// leaked token alone from being enough, and stops replay of a modified body.
  signingSecret String

  /// The external system this key belongs to, when it is a named connector
  /// rather than a generic key: a Shopify shop domain like `acme.myshopify.com`.
  ///
  /// Shopify webhooks cannot carry a custom header or a bearer token, so the
  /// only thing identifying the caller is `X-Shopify-Shop-Domain`. This column
  /// is what turns that into a tenant. Unique, because one shop posting into
  /// two workspaces is not a configuration, it is a mistake.
  externalDomain String? @unique

  /// Revocation without deletion, so the audit trail survives.
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingests IngestRequest[]

  @@index([factoryId])
  @@index([factoryId, revokedAt])
}

/// One inbound request, recorded so a retry cannot book the order twice.
///
/// Shopify and every other sane webhook sender retries on timeout, and a
/// timeout is exactly when the write most likely *did* land. Without this a
/// slow response means two identical orders on the floor, which nobody notices
/// until someone has cut fabric for both.
///
/// The stored `response` is replayed verbatim on a repeat, so the caller sees
/// the same order id it would have seen the first time.
model IngestRequest {
  id        String @id @default(cuid())
  factoryId String

  apiKeyId String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  /// Caller-supplied `Idempotency-Key`, or a hash of the body when absent.
  idempotencyKey String

  /// What was returned the first time, replayed on a repeat.
  status   Int
  response Json

  /// The order this created, when it created one.
  salesOrderId String?

  createdAt DateTime @default(now())

  /// Scoped to the tenant, not global: two tenants may legitimately use the
  /// same key, and a global unique would let one tenant's traffic silently
  /// suppress another's order.
  @@unique([factoryId, idempotencyKey])
  @@index([factoryId])
}

/// Where a tenant wants milestone notifications delivered.
///
/// The URL is tenant-supplied, which makes every delivery an authenticated
/// outbound request to an address we do not control — i.e. SSRF. `lib/webhooks/
/// url-guard.ts` refuses private and link-local ranges both when the endpoint is
/// saved and again before each delivery, because DNS can be repointed in between.
model WebhookEndpoint {
  id        String @id @default(cuid())
  factoryId String

  name String
  url  String

  /// HMAC secret for the outgoing `X-Verity-Signature`, so the receiver can
  /// verify the call came from us.
  secret String

  /// Event names this endpoint wants. Empty means all of them.
  events String[]

  isActive Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([factoryId])
  @@index([factoryId, isActive])
}

/// The outbox. One row per delivery owed.
///
/// This table exists because there is no worker process on Vercel: a
/// fire-and-forget `fetch` after the response is killed with the invocation, and
/// the failure is invisible — the external system simply never hears that an
/// order shipped. Writing the intent down first means a delivery survives the
/// process that created it, and `attempts`/`nextAttemptAt` let a failed one be
/// retried by the drain rather than lost.
model WebhookDelivery {
  id        String @id @default(cuid())
  factoryId String

  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  event   String
  payload Json

  /// PENDING, DELIVERING, DELIVERED, FAILED
  status String @default("PENDING")

  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  deliveredAt   DateTime?

  /// Last failure, kept so an operator can see *why* rather than just "failed".
  lastError  String?
  lastStatus Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The drain claims work with this: pending rows whose time has come, oldest
  /// first.
  @@index([status, nextAttemptAt])
  @@index([factoryId])
  @@index([endpointId])
}

// ==========================================
// PLATFORM BILLING
//
// Verity charging the tenant. Deliberately separate from ServiceInvoice, which
// is the tenant charging *their* customer — a facility-management company
// billing a client for a month of guarding. Sharing one table would put
// Verity's revenue inside the tenant's own books, visible on their screens and
// included in their Tally export.
//
// See docs/prd/01-metering-and-billing.md. Prices live in
// src/platform/pricing.ts, with a test that recomputes every pack discount.
// ==========================================

/// Team size as three flat brackets, not a per-seat count.
///
/// Per-user pricing was dropped on purpose: it contradicted the competitive
/// position (which argues against per-seat), and at fifty users it nearly
/// doubled the bill — recreating the economics the whole product attacks. A
/// factory with eighty floor workers is one flat LARGE, and nobody has to audit
/// a headcount to produce an invoice.
enum TeamSizeBracket {
  SMALL // up to 10 — included in the base
  MEDIUM // 11–50
  LARGE // 51+
}

enum SubscriptionStatus {
  /// 7 days, no card. Full access.
  TRIAL
  /// Paying.
  ACTIVE
  /// The trial lapsed without converting. Workspace is readable, not writable.
  TRIAL_EXPIRED
  /// A paying tenant who lapsed. Same access as TRIAL_EXPIRED, different story
  /// and a different recovery path — which is why it is not one state.
  READ_ONLY
  /// Deliberately ended.
  CANCELLED
}

model TenantSubscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status SubscriptionStatus @default(TRIAL)

  /// Set when the tenant is on a vertical pack; null when à la carte. Modules
  /// are still the source of truth for *access* — this only decides the price.
  packKey String?

  teamSizeBracket TeamSizeBracket @default(SMALL)

  /// All amounts are **paise**, as integers. Never a Float: a rounding error in
  /// a price is a support conversation nobody can win.
  ///
  /// Snapshotted at signup rather than read live from the price list. A tenant
  /// who signed at ₹19,999 keeps paying it when the list moves, until someone
  /// deliberately re-prices them — the alternative silently raises every
  /// existing customer's bill the moment marketing edits a number.
  basePrice    Int
  bracketPrice Int @default(0)

  /// When the free trial ends. Day 5 triggers the assistant's nudge, day 8 the
  /// workspace goes read-only.
  trialEndsAt DateTime?

  /// When the workspace became read-only, whether from a lapsed trial or a
  /// lapsed subscription. Retention counts from here, not from trialEndsAt —
  /// a tenant who paid for six months and then lapsed gets the same 30 days as
  /// one who never paid, counted from when they actually lost write access.
  readOnlySince DateTime?

  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime

  /// Assistant tokens spent in the current window, and when that window opened.
  ///
  /// Counted rather than metered live because the cap only has to be roughly
  /// right: it exists so a runaway loop cannot bill a month of inference in an
  /// afternoon, not to bill the tenant per token. A null reset means the window
  /// has never opened; the first request stamps it.
  assistantTokensUsed   Int       @default(0)
  assistantTokenResetAt DateTime?

  lines    SubscriptionLine[]
  invoices PlatformInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The drain that expires trials and lapses subscriptions claims work with
  /// these two together.
  @@index([status, trialEndsAt])
  @@index([status, readOnlySince])
}

/// One charge on a subscription: a module, the platform fee, or the team bracket.
///
/// Append-only with a validity window. Deactivating a module **closes** its line;
/// it never deletes it. Last month's invoice has to stay explainable in six
/// months, and that is impossible if the line it was built from is gone.
model SubscriptionLine {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// A module key, or the reserved "platform" / "team" for the base and bracket.
  itemKey String
  /// What the customer reads on the invoice.
  label   String

  /// Paise, snapshotted when the line opened. Never read live — a price change
  /// must not silently re-bill everyone already on the old one.
  unitPrice Int
  quantity  Int @default(1)

  activeFrom DateTime  @default(now())
  /// Null while the line is still being charged.
  activeTo   DateTime?

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@index([subscriptionId, activeTo])
}

/// A month's bill for one tenant. Verity → tenant, never tenant → their customer.
model PlatformInvoice {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organizationId String

  /// Sequential per tenant, so an accountant can spot a gap.
  invoiceNumber String @unique

  periodStart DateTime
  periodEnd   DateTime

  /// Paise. Sum of the lines below, stored so the total cannot drift from what
  /// was sent when a price later changes.
  subtotal Int
  total    Int

  /// DRAFT, ISSUED, PAID, VOID. Not an enum yet: payment collection is out of
  /// scope, and inventing the states before the gateway is chosen would mean
  /// migrating them once it is.
  status String @default("DRAFT")

  issuedAt DateTime?
  paidAt   DateTime?

  lines PlatformInvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One invoice per tenant per period. This is what makes generation idempotent
  /// — a cron that runs twice cannot bill twice.
  @@unique([subscriptionId, periodStart])
  @@index([organizationId])
  @@index([status])
}

/// A frozen copy of a charge line at the moment the invoice was cut.
///
/// Deliberately a copy rather than a relation to SubscriptionLine: an invoice is
/// a historical statement, and it must render identically in two years even if
/// the line it came from has been closed, re-priced, or the module retired.
model PlatformInvoiceLine {
  id        String          @id @default(cuid())
  invoiceId String
  invoice   PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  itemKey   String
  label     String
  unitPrice Int
  quantity  Int @default(1)
  amount    Int

  @@index([invoiceId])
}

// ==========================================
// RESTAURANT OS — MENU
// ==========================================

/// A section of the menu — Starters, Breads, Desserts.
model MenuCategory {
  id        String  @id @default(cuid())
  factoryId String
  name      String
  sortOrder Int     @default(0)

  items   MenuItem[]
  factory Factory    @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  // Two categories called "Starters" in one restaurant is a data-entry mistake,
  // not a use case: the second one is invisible on the printed card and splits
  // the reporting.
  @@unique([factoryId, name])
  @@index([factoryId])
}

model MenuItem {
  id          String  @id @default(cuid())
  factoryId   String
  categoryId  String
  name        String
  description String?
  /// Paise, as an integer. A menu price that is a float is a rounded bill.
  price       Int
  isVeg       Boolean @default(true)
  /// False when it has run out. Kept off the menu without deleting the item —
  /// deleting would lose its price, photo and history for the sake of one service.
  available   Boolean @default(true)
  imageUrl    String?
  notes       String?
  sortOrder   Int     @default(0)

  category   MenuCategory      @relation(fields: [categoryId], references: [id])
  factory    Factory           @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  orderItems DiningOrderItem[]

  @@index([factoryId])
  @@index([categoryId])
  // The availability toggle is the hot path during service, and the kitchen
  // display reads "what is on right now" constantly.
  @@index([factoryId, available])
}

// ==========================================
// RESTAURANT OS — TABLES & ORDERS
// ==========================================

/// Where the floor staff look. The order is the source of truth for what is
/// happening; this is the shape of the room.
model RestaurantTable {
  id        String     @id @default(cuid())
  factoryId String
  number    String /// "T01", "Patio 3" — free text, because floors are named not numbered
  capacity  Int
  state     TableState @default(AVAILABLE)

  orders  DiningOrder[]
  factory Factory       @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  // Two tables called T01 is a data-entry error that puts an order on the wrong
  // one.
  @@unique([factoryId, number])
  @@index([factoryId])
}

enum TableState {
  AVAILABLE
  OCCUPIED
  ORDERED
  PREPARING
  READY
  SERVED
  BILLING
  PAID
}

model DiningOrder {
  id         String     @id @default(cuid())
  factoryId  String
  tableId    String
  customerId String?
  notes      String?
  state      OrderState @default(NEW)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items   DiningOrderItem[]
  table   RestaurantTable   @relation(fields: [tableId], references: [id])
  bill    DiningBill?
  factory Factory           @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([factoryId])
  @@index([tableId])
  // "What is live on the floor" is the query the whole module runs constantly.
  @@index([factoryId, state])
}

enum OrderState {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  BILLED
  PAID
  CANCELLED
}

model DiningOrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  notes      String?

  /// The price per unit **at the moment it was ordered**, in paise.
  ///
  /// Snapshotted rather than read through to `MenuItem.price`, because this order
  /// reaches BILLED and PAID: without it, repricing the menu silently rewrites
  /// what a settled bill says it charged. The same reason the subscription
  /// invoice lines snapshot their prices.
  unitPrice  Int     @default(0)

  order    DiningOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem    @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
}

// ==========================================
// RESTAURANT OS — BILLING
// ==========================================

/// One bill per order. All amounts are integer paise.
model DiningBill {
  id            String         @id @default(cuid())
  factoryId     String
  orderId       String         @unique
  subtotal      Int
  discountPaise Int            @default(0)
  taxPaise      Int            @default(0)
  total         Int
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  createdAt     DateTime       @default(now())

  order   DiningOrder @relation(fields: [orderId], references: [id])
  factory Factory     @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([factoryId])
  // Today's takings, split by method — the one report a restaurant runs daily.
  @@index([factoryId, paidAt])
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}
